  "operator-number": "številka",
  "globalSearch-instructions-operator-number": "`__operator_number__:<number>` - kartice, katerih številka je *<number>*",
  "subtask-inherit-parent-labels": "Podeduj oznake nadrejene kartice",
  "subtask-mark-done": "Označi podnalogo kot dokončano",
  "subtask-mark-not-done": "Označi podnalogo kot nedokončano",
