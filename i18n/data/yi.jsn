  "password-length-filter-short": "צו קורץ פּאַראָל",
  "password-length-first-login": "ערשטער לאָגין",
  "password-length-fixed": "פֿאַרריכט",
  "password-length-from-environment": "אַ ווערט וואָס איז געשטעלט אין דער סבֿיבֿה פֿונעם סערווער איז אין קראַפֿט; אויפֿהיטן דאָ פֿאַרבײַט עס.",
  "password-length-last-login": "לעצטער לאָגין",
  "password-length-login-count": "מאָל אַרײַנלאָגירט",
  "password-length-no-results": "קיין קאָנטעס זענען דאָ נישטאָ.",
  "password-length-report-desc": "קאָנטעס וואָס האָבן זיך אַרײַנלאָגירט מיט אַ פּאַראָל קירצער ווי די מינימום־לענג. נאָר דער בלעטערער ווייסט ווי לאַנג אַ פּאַראָל איז, דערפֿאַר מעלדט ער וועגן אַ קורצן נאָכן אַרײַנלאָגירן; דאָס פּאַראָל און זײַן לענג פֿאַרלאָזן אים קיינמאָל נישט. פֿאַרריכט איז ווען דאָס פּאַראָל פֿונעם קאָנטע איז געביטן געוואָרן - אַ קאָנטע וואָס לאָגירט זיך ווידער אַרײַן מיט אַ קורץ פּאַראָל ווערט ווידער געוויזן ווי צו קורץ.",
  "password-length-saved": "אויפֿגעהיט.",
  "password-min-length": "מינימום פּאַראָל־לענג",
  "password-min-length-description": "אַרײַנלאָגירן מיט אַ קירצער פּאַראָל ווערט אויסגערעכנט אונטן. אַרײַנלאָגירן ווערט צוליב דעם קיינמאָל נישט אָפּגעזאָגט.",
  "password-min-length-enforce": "פֿאָדערן די מינימום־לענג",
  "password-min-length-enforce-description": "אַ קירצער נײַ פּאַראָל ווערט אָפּגעזאָגט, און אַ קאָנטע וואָס לאָגירט זיך אַרײַן מיט אַ קירצער פּאַראָל מוז עס בײַטן איידער עפּעס אַנדערש. דאָס בײַטן לאָגירט אויס יעדע סעסיע פֿונעם קאָנטע. LDAP, OAuth2, OIDC, SAML, CAS און Sandstorm פּאַראָלן געהערן צו זייער צושטעלער, און ווערן נישט געקאָנטראָלירט.",
  "password-change-required-text": "דער זײַטל פֿאָדערט איצט פּאַראָלן פֿון כאָטש __min__ צייכנס, און אײַערס איז קירצער. קלײַבט אויס אַ לענגערס כּדי ווײַטער צו גיין. דערנאָך ווערט יעדע סעסיע פֿון אײַער קאָנטע אויסגעלאָגירט, און איר לאָגירט זיך ווידער אַרײַן מיטן נײַעם פּאַראָל.",
  "date-format-for-everyone": "דאַטע־פֿאָרמאַט פֿאַר אַלעמען",
  "calendar-system": "קאַלענדאַר־סיסטעם (דאַטע־ווײַזונג)",
  "show-unread-changes": "צייכן אָן קאָרטן וואָס האָבן זיך געביטן זינט איך האָב זיי לעצטנס געעפֿנט",
  "show-unread-changes-desc": "א קאָרט וועמענס טיטל, באַשרײַבונג, דאַטעס, עטיקעטן, מיטגלידער, קאָנטראָל־רשימות, צוגעלייגטע טעקעס אָדער באַמערקונגען האָבן זיך געביטן נאָך דעם ווי איר האָט עס לעצטנס געעפֿנט, באַקומט א בלויען ראַנד אויף זײַן מיני־קאָרט, ביז איר עפֿנט עס.",
  "keep-title-tags": "האַלט #לאַבעל און @מיטגליד אין טיטלען פֿון נײַע קאָרטן",
  "keep-title-tags-description": "ווען איר קלײַבט אויס אַ לאַבעל מיט # אָדער אַ מיטגליד מיט @ בשעת איר שרײַבט דעם טיטל פֿון אַ נײַער קאָרט, האַלט דעם טעקסט אויך אינעם טיטל. אויס: דער טעקסט ווערט פֿאַרביטן מיטן לאַבעל אָדער מיטגליד.",
  "show-focus-outline": "ווײַז דעם פֿאָקוס־קאָנטור",
  "keep-add-card-form-open": "האַלטן די פֿאָרעם פֿון צולייגן אַ קאָרט אָפֿן נאָכן צולייגן אַ קאָרט",
  "keep-add-card-form-open-description": "אָן: נאָך דעם ווי מען לייגט צו אַ קאָרט, בלייבט די פֿאָרעם אָפֿן מיט אַ ליידיקן טיטל פֿאַר דעם נעקסטן קאָרט. אויס: די פֿאָרעם פֿאַרמאַכט זיך ווען דער קאָרט איז צוגעלייגט.",
  "title-bracket-label": "פֿאַרוואַנדל [לאַבעל] בײַם אָנהייב פֿון אַ נײַעם קאָרט־טיטל אין אַ לאַבעל",
  "title-bracket-label-description": "ווען דער טיטל פֿון אַ נײַער קאָרט הייבט זיך אָן מיט [טעקסט] און נאָך דעם קומט נאָך טעקסט, ווערט טעקסט אַ לאַבעל פֿון דער קאָרט (געשאַפֿן אויב דער ברעט האָט נישט קיין לאַבעל מיט דעם נאָמען) און ווערט אַוועקגענומען פֿונעם טיטל. אויס: דער טיטל בלײַבט ווי ער איז.",
  "submit-on-enter": "שיק ארויס רעדאקטארן מיט Enter",
  "submit-on-enter-description": "ווען אָנגעצונדן, דריקן Enter היט די קאָרטל־טיטל, באַשרייַבונג און אנדערע אינלײַן־רעדאקטארן; Shift+Enter לייגט צו א נײַע ליניע. ווען אויסגעלאשן, Ctrl/Cmd+Enter היט און Enter לייגט צו א נײַע ליניע.",
  "open-many-cards-at-once": "עפֿן פֿיל קאָרטן אויף אַ מאָל",
  "open-many-cards-at-once-description": "יעדע קאָרט וואָס איר קליקט בלײַבט אָפֿן אין איר אייגענעם פֿענצטער. ווען דאָס איז אויסגעשלאָסן, שליסט אַ קליק אויף אַ קאָרט די וואָס איז געווען אָפֿן.",
  "checklist-ding-sound": "שפילן א קלאנג ווען אַ טשעקליסט־זאַך ווערט פארענדיקט",
  "checklist-ding-sound-description": "שפילט אַ קורצן קלאַנג ווען איר טשעקירט אַ טשעקליסט־זאַך. אַרויס לויט ברירה.",
