  "recoveryReportTitle": "Obnova",
  "securityReportTitle": "Bezpečnosť",
  "event-ipv4": "IPv4 adresa",
  "event-ipv6": "IPv6 adresa",
  "password-change-required-title": "Zmeňte si heslo",
  "password-length-filter-all": "Všetky",
  "password-length-filter-fixed": "Opravené na dostatočne dlhé heslo",
  "password-length-filter-short": "Príliš krátke heslo",
  "password-length-first-login": "Prvé prihlásenie",
  "password-length-fixed": "Opravené",
  "password-length-from-environment": "Platí hodnota nastavená v prostredí servera; uložením tu sa prepíše.",
  "password-length-last-login": "Posledné prihlásenie",
  "password-length-login-count": "Počet prihlásení",
  "password-length-no-results": "Žiadne účty.",
  "password-length-report-desc": "Účty, ktoré sa prihlásili s heslom kratším ako minimálna dĺžka. Len prehliadač vie, aké dlhé je heslo, preto po prihlásení nahlási krátke heslo; heslo ani jeho dĺžka ho nikdy neopustia. Opravené je chvíľa, keď sa heslo účtu zmenilo - účet, ktorý sa znova prihlási s krátkym heslom, sa znova zobrazí ako príliš krátky.",
  "password-length-saved": "Uložené.",
  "password-min-length": "Minimálna dĺžka hesla",
  "password-min-length-description": "Prihlásenie s kratším heslom je uvedené nižšie. Prihlásenie sa kvôli tomu nikdy neodmietne.",
  "password-min-length-enforce": "Vynútiť minimálnu dĺžku",
  "password-min-length-enforce-description": "Kratšie nové heslo sa odmietne a účet, ktorý sa prihlási s kratším heslom, ho musí pred čímkoľvek iným zmeniť. Jeho zmena odhlási všetky relácie účtu. Heslá LDAP, OAuth2, OIDC, SAML, CAS a Sandstorm patria ich poskytovateľovi a nekontrolujú sa.",
  "password-change-required-text": "Táto stránka teraz vyžaduje heslá s aspoň __min__ znakmi a vaše je kratšie. Ak chcete pokračovať, zvoľte dlhšie. Potom sa všetky relácie vášho účtu odhlásia a prihlásite sa znova s novým heslom.",
  "date-format-for-everyone": "Formát dátumu pre všetkých",
  "calendar-system": "Kalendárny systém (zobrazenie dátumu)",
  "show-unread-changes": "Označiť karty zmenené od môjho posledného otvorenia",
  "show-unread-changes-desc": "Karta, ktorej názov, popis, dátumy, štítky, členovia, kontrolné zoznamy, prílohy alebo komentáre sa zmenili po tom, čo ste ju naposledy otvorili, dostane na minikarte modrý okraj, kým ju neotvoríte.",
  "keep-title-tags": "Zachovať #štítok a @člena v názvoch nových kariet",
  "keep-title-tags-description": "Keď pri písaní názvu novej karty vyberiete štítok pomocou # alebo člena pomocou @, tento text zostane aj v názve. Vypnuté: text sa nahradí štítkom alebo členom.",
  "show-focus-outline": "Zobraziť obrys zamerania",
  "keep-add-card-form-open": "Ponechať formulár na pridanie karty otvorený po pridaní karty",
  "keep-add-card-form-open-description": "Zapnuté: po pridaní karty zostane formulár otvorený s prázdnym názvom pre ďalšiu kartu. Vypnuté: formulár sa zatvorí hneď po pridaní karty.",
  "title-bracket-label": "Premeniť [štítok] na začiatku názvu novej karty na štítok",
  "title-bracket-label-description": "Keď názov novej karty začína textom [Text], po ktorom nasleduje ďalší text, Text sa stane štítkom karty (vytvorí sa, ak nástenka nemá štítok s týmto názvom) a odstráni sa z názvu. Vypnuté: názov zostane taký, aký je.",
  "submit-on-enter": "Odoslať editory klávesom Enter",
  "submit-on-enter-description": "Keď je zapnuté, stlačenie Enter uloží názov karty, popis a ďalšie vložené editory; Shift+Enter vloží nový riadok. Keď je vypnuté, Ctrl/Cmd+Enter uloží a Enter vloží nový riadok.",
  "open-many-cards-at-once": "Otvoriť viac kariet naraz",
  "open-many-cards-at-once-description": "Každá karta, na ktorú kliknete, zostane otvorená vo vlastnom okne. Keď je toto vypnuté, kliknutie na kartu zavrie tú, ktorá bola otvorená.",
  "checklist-ding-sound": "Prehrať zvuk po dokončení položky kontrolného zoznamu",
  "checklist-ding-sound-description": "Prehrá krátky zvuk pri začiarknutí položky kontrolného zoznamu. V predvolenom nastavení vypnuté.",
