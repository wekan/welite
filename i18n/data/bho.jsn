  "password-length-from-environment": "सर्वर के वातावरण में सेट कइल एगो मान लागू बा; इहाँ सहेजला से ऊ बदल जाला।",
  "password-length-last-login": "आखिरी लॉगिन",
  "password-length-login-count": "केतना बेर लॉगिन भइल",
  "password-length-no-results": "इहाँ कवनो खाता नइखे।",
  "password-length-report-desc": "ऊ खाता जवन न्यूनतम लंबाई से छोट पासवर्ड से साइन इन कइलें। पासवर्ड केतना लंबा बा ई खाली ब्राउजर जानेला, एही से साइन इन के बाद ऊ छोट पासवर्ड के जानकारी देला; पासवर्ड आ ओकर लंबाई कबो ओकरा से बाहर ना जाला। ठीक भइल माने जब खाता के पासवर्ड बदलल गइल - जवन खाता फेर से छोट पासवर्ड से साइन इन करी, ऊ फेर से बहुत छोट देखावल जाई।",
  "password-length-saved": "सहेजल गइल।",
  "password-min-length": "न्यूनतम पासवर्ड लंबाई",
  "password-min-length-description": "छोट पासवर्ड से साइन इन कइल नीचे सूची में देखावल जाला। एकरा चलते साइन इन कबो मना ना कइल जाला।",
  "password-min-length-enforce": "न्यूनतम लंबाई लागू करीं",
  "password-min-length-enforce-description": "छोट नया पासवर्ड मना कर दिहल जाला, आ जवन खाता छोट पासवर्ड से साइन इन करेला ओकरा कवनो दोसर काम से पहिले एकरा के बदले के पड़ी। एकरा के बदलला से खाता के हर सत्र से साइन आउट हो जाला। LDAP, OAuth2, OIDC, SAML, CAS आ Sandstorm के पासवर्ड ओह लोग के प्रदाता के होला, आ जाँचल ना जाला।",
  "password-change-required-text": "ई साइट अब कम से कम __min__ अक्षर के पासवर्ड माँगेले, आ रउआ के छोट बा। आगे बढ़े खातिर एगो लंबा पासवर्ड चुनीं। ओकरा बाद रउआ खाता के हर सत्र से साइन आउट हो जाई, आ रउआ नया पासवर्ड से फेर से साइन इन करब।",
  "date-format-for-everyone": "सब खातिर तारीख के रूप",
  "calendar-system": "कैलेंडर प्रणाली (तारीख देखावे खातिर)",
  "show-unread-changes": "जवन कार्ड हम पिछला बेर खोलला के बाद बदलल बा, ओकरा के चिन्हित करीं",
  "show-unread-changes-desc": "जवना कार्ड के शीर्षक, विवरण, तारीख, लेबल, सदस्य, चेकलिस्ट, संलग्नक भा टिप्पणी रउआ पिछला बेर खोलला के बाद बदलल बा, ओकरा मिनीकार्ड पर नीला किनारा लउकी, जबले रउआ ओकरा के ना खोलब।",
  "keep-title-tags": "नया कार्ड के शीर्षक में #लेबल आ @सदस्य रखीं",
  "keep-title-tags-description": "जब रउआ नया कार्ड के शीर्षक लिखत घरी # से लेबल भा @ से सदस्य चुनीं, त ऊ लिखल शीर्षक में भी रहे। बंद: लिखल के जगह लेबल भा सदस्य आ जाला।",
  "show-focus-outline": "फोकस आउटलाइन देखाईं",
  "keep-add-card-form-open": "कार्ड जोड़ला के बाद कार्ड जोड़े वाला फॉर्म खुलल रखीं",
  "keep-add-card-form-open-description": "चालू: कार्ड जोड़ला के बाद, अगिला कार्ड खातिर खाली शीर्षक के साथे फॉर्म खुलल रहेला। बंद: कार्ड जुड़ते फॉर्म बंद हो जाला।",
  "title-bracket-label": "नया कार्ड के शीर्षक के शुरुआत में [लेबल] के लेबल बना दीं",
  "title-bracket-label-description": "जब नया कार्ड के शीर्षक [पाठ] से शुरू होखे आ ओकरा बाद अउरी लिखल होखे, त पाठ कार्ड के लेबल बन जाला (अगर बोर्ड में ओह नाम के लेबल ना होखे त बनावल जाला) आ शीर्षक से हटा दिहल जाला। बंद: शीर्षक जइसन बा ओइसने रहेला।",
  "submit-on-enter": "एंटर से संपादक जमा करीं",
  "submit-on-enter-description": "चालू होखे त Enter दबइला से कार्ड शीर्षक, विवरण आ दोसरा पाँति वाला संपादक सहेजल जाला; Shift+Enter नया पाँति जोड़ेला। बंद होखे त Ctrl/Cmd+Enter सहेजेला आ Enter नया पाँति जोड़ेला।",
  "open-many-cards-at-once": "एक साथ बहुत कार्ड खोलीं",
  "open-many-cards-at-once-description": "क्लिक कइल हर कार्ड के ओकर आपन खिड़की में खुलल राखीं। ई बंद होखे त कार्ड पर क्लिक कइला से पहिले खुलल कार्ड बंद हो जाला।",
  "checklist-ding-sound": "चेकलिस्ट आइटम पूरा होखला पर आवाज बजाईं",
  "checklist-ding-sound-description": "चेकलिस्ट आइटम चेक करला पर छोट आवाज बजाईं। डिफॉल्ट रूप से बंद।",
