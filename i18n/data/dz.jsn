  "import-json-file": "ཡང་ན་ Trello JSON ཡིག་སྣོད་གདམ་ཁ་རྐྱབ།",
  "import-attachments-zip": "Trello མཉམ་སྦྲགས་ ZIP (གདམ་ཁ་ཅན། Trello Card Attachments Downloader ལས་)",
  "import-trello-json-file": "Trello .json ཡིག་སྣོད།",
  "import-trello-json-file-hint": "Trello བྱང་གཞི་གཅིག་ .json སྦེ་ཕྱིར་འདྲེན་འབད་ཡོད། Trello API ལྡེ་མིག་དང་ངོ་རྟགས་སྲུང་བཞག་འབད་ཡོད་པ་ཅིན་མཉམ་སྦྲགས། བྱང་གཞིའི་རྒྱབ་གཞི་དང་འཐུས་མིའི་མགོ་པར་ཚུ་ཡང་ཕབ་ལེན་འབད་འོང་།",
