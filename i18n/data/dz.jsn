  "wip-limit-groups": "WIP ཚད་ལྕོགས་ཅན་བཟོ། (ཐོ་ཡིག)",
  "wip-limit-group-name-placeholder": "མིང་། (གདམ་ཁ།)",
  "wip-limit-group-add": "ཁ་སྐོང་། WIP ཚད་ལྕོགས་ཅན་བཟོ།",
  "wip-limit-group-select-swimlane": "བྱང་གཞི་འདེམས། ལམ།",
  "wip-limit-group-apply-swimlane": "འཇུག་སྤྱོད། ལམ།",
  "board-view-time": "དུས་ཚོད།",
  "time-adjustments": "ཆུ་ཚོད། — Δ — ལག་ལེན་པའི་མིང་།",
  "time-adjustment-note": "ལོ་རྒྱུས།: Δ ཆུ་ཚོད།; ལག་ལེན་པའི་མིང་། ≠ འགན་འབག་མི་ཚུ།.",
  "auto-archive-days": "ཉིནམ་འདི་དེ་ཅིག་ལས་འགུལ་མེད་པར་སྡོད་མི་ཤོག་བྱང་ཚུ་ཡིག་མཛོད་ནང་སྤོ།",
  "auto-archive-off": "བཀག་བཞག་ཡོདཔ།",
  "auto-archive-hint": "ཆུ་ཚོད་རེ་རེ་བཞིན་དུ་ཞིབ་དཔྱད་འབདཝ་ཨིན། ཤོག་བྱང་བསྒྱུར་བཅོས་འབད་བའི་སྐབས་ལས་འགུལ་ཡོདཔ་སྦེ་རྩིཝ་ཨིན། དཔེ་གཞི་ཚུ་ནམ་ཡང་ཡིག་མཛོད་ནང་མི་སྤོ། བཀག་བཞག་ནིའི་དོན་ལུ་སྟོངམ་སྦེ་བཞག།",
  "import-board-instruction-markdown": "མར་ཀ་ཌའུན་ལཱ་གྱི་ཐོ་ཡིག་ཅིག་སྦྱར་གནང་ (Obsidian Kanban ཚུགཔ་སྦེ་ markdown-kanban ལག་ཆས་ཚུས་ལག་ལེན་འཐབ་མི་སྲོལ)： འོག་ལུ་ \"- [ ]\"/\"- [x]\" ཐངས་ཚུ་དང་གཅིག་ཁར་ \"## ཐོ་ཡིག་གི་མིང་\" མགོ་མིང་ཚུ།",
  "import-board-instruction-opml": "OPML ཐོ་ཡིག་ཅིག་སྦྱར་ (Workflowy, Dynalist, OmniOutliner, Logseq དང་ outliner གཞན་ཚུ་གིས་ཕྱིར་སྐྱེལ་འབད་དོ་བཟུམ་)། གོང་རིམ་གྱི་དོན་ཚན་ཚུ་ཐོ་ཡིག་ལུ་འགྱུར་ཏེ་ དེ་གི་ཡན་ལག་ཚུ་ཟིན་ཐོ་འདི་འགྲེལ་བཤད་བཟུམ་སྦེ་ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན་ དེ་ལས་ གཏིང་ཟབ་པའི་དོན་ཚན་ཚུ་ཞིབ་ཐོ་ལུ་འགྱུརཝ་ཨིན། མཇུག་བསྡུ་ཡོད་པའི་དོན་ཚན་ཚུ་ མཇུག་བསྡུ་ཡི་ཟེར་ནང་འདྲེན་འབདཝ་ཨིན།",
  "import-board-instruction-todotxt": "todo.txt ཡིག་སྣོད་ཅིག་སྦྱར། todo.txt གློག་རིམ་དང་ དེ་དང་མཐུན་པའི་གློག་རིམ་ཚུ་གིས་འབྲི་དོ་བཟུམ་སྦེ་ གྲལ་ཐིག་རེ་ནང་ལཱ་རེ་བཙུགས། མཇུག་བསྡུ་ཡོད་པའི་ལཱ་(\"x\") ཚུ་«མཇུག་བསྡུ་ཡི»ནང་སྤོ་འོང་། +project དང་ @context ཚུ་ཁ་ཡིག་ལུ་འགྱུར་འོང་། (A) འདི་གཙོ་རིམ་ཁ་ཡིག་ལུ་འགྱུར་འོང་། due: དང་ t: ཚུ་དུས་ཚོད་ཚང་བའི་ཚེས་གྲངས་དང་ འགོ་བཙུགས་ཚེས་གྲངས་ལུ་འགྱུར་འོང་།",
  "import-board-instruction-taskwarrior": "JSON གྲལ་སྒྲིག་ཅིག་ ཡང་ན་ གྲལ་ཐིག་རེ་ནང་ལཱ་རེ་ཡོད་པའི་ task export གི་གྲུབ་འབྲས་སྦྱར། མཇུག་བསྡུ་ཚར་མི་ལཱ་ཚུ་ Done ནང་འགྱོཝ་ཨིན། project དང་ priority ཚུ་ཁ་ཡིག་ལུ་འགྱུརཝ་ཨིན། annotations བསམ་འཆར་ལུ་འགྱུརཝ་ཨིནམ་དང་ depends དེ་ བཀག་བཞག་མི་ལཱ་གཞན་ལུ་བརྟེན་དགོ་པའི་འབྲེལ་བ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-meistertask": "MeisterTask ནང་ ལས་འགུལ་གྱི་མིང་གུ་ཨེབ་གཏང་ Export project གདམ་ཞིནམ་ལས་ CSV ཕྱིར་སྐྱེལ་འབད་ དེ་ལས་སྦྱར། དབྱེ་ཚན་ཚུ་ཐོ་ཡིག་ལུ་འགྱུར་ཏེ་ ལས་འགན་ཚུ་ ཟིན་ཐོ་, དུས་ཚོད་ཚེས་, འགན་འཁུར་པ་དང་ ཁ་ཡིག་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། མཇུག་བསྡུ་ཡོད་པའི་ལས་འགན་ཚུ་གིས་ མཇུག་བསྡུ་བའི་ཚེས་གྲངས་བཞགཔ་ཨིན། MeisterTask རང་གི་ནང་འདྲེན་གྱི་དོན་ལུ་འབྲི་ཡོད་པའི་ CSV ཡང་ལཱ་འབདཝ་ཨིན།",
  "import-board-instruction-obsidian": "Obsidian ནང་ Kanban བྱང་གཞིའི་ཡིག་སྣོད་འདི་ Markdown སྦེ་ཁ་ཕྱེ་ (ཡང་ན་ .md ཡིག་སྣོད་འདི་ཚིག་ཡིག་ཞུན་དག་ཆས་ནང་ཁ་ཕྱེ་), དེ་ལས་ ཆ་མཉམ་སྦྱར། ལམ་ཚུ་ ཤོག་བྱང་གི་ཚད་གཞི་དང་གཅིག་ཁར་ཐོ་ཡིག་ལུ་འགྱུརཝ་ཨིན་ ཤོག་བྱང་ཚུ་གིས་ ཁ་ཡིག་, ཚེས་གྲངས་, གཙོ་རིམ་, ས་སྒོ་དང་ ཞིབ་ཐོ་ཚུ་བཞགཔ་ཨིན་ དེ་ལས་ Archive འདི་ ཡིག་མཛོད་ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-linear": "Linear ནང་ གནད་དོན་ཚུ་ CSV སྦེ་ཕྱིར་སྐྱེལ་འབད་ (Settings, Import / Export, Export data, ཡང་ན་ མཐོང་སྣང་གི་ཕྱིར་སྐྱེལ་), དེ་ལས་ CSV འདི་སྦྱར། གནས་སྟངས་ཚུ་ཐོ་ཡིག་ལུ་ སྡེ་ཚན་ཚུ་ཆུ་ལམ་ལུ་ དེ་ལས་ གནད་དོན་ཚུ་ འགན་འཁུར་པ་, ཁ་ཡིག་, ཚེས་གྲངས་, ཕ་མའི་གནད་དོན་, གཙོ་རིམ་, ཚོད་རྩིས་, ལས་འགུལ་དང་ འཁོར་རིམ་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-ticktick": "TickTick ནང་ Settings, Account, Backup & Import ཁ་ཕྱེ་ཞིནམ་ལས་ རྒྱབ་འདྲ་ཅིག་བཟོ་ དེ་ལས་ CSV ཡིག་སྣོད་འདི་སྦྱར། TickTick ཐོ་ཡིག་རེ་རེ་ ཆུ་ལམ་ལུ་འགྱུར་ཏེ་ དེ་གི་ཀ་ཐིག་ཚུ་ཐོ་ཡིག་ལུ་འགྱུརཝ་ཨིན། ལས་འགན་ཚུ་གིས་ ཁ་ཡིག་, ཚེས་གྲངས་, ཞིབ་ཐོ་, གཙོ་རིམ་དང་ ལས་འགན་ཆུང་ཀུ་ཚུ་བཞགཔ་ཨིན།",
  "import-board-instruction-clickup": "ClickUp ནང་ ལས་འགན་ཚུ་ CSV སྦེ་ཕྱིར་སྐྱེལ་འབད་ (Settings, Imports / Exports, Export Items, ཡང་ན་ ཀ་ཐིག་ཆ་མཉམ་དང་གཅིག་ཁར་ List ཡང་ན་ Table མཐོང་སྣང་གི་ཕྱིར་སྐྱེལ་), དེ་ལས་ CSV འདི་སྦྱར། གནས་སྟངས་ཚུ་ཐོ་ཡིག་ལུ་ ClickUp ཐོ་ཡིག་ཚུ་ཆུ་ལམ་ལུ་ དེ་ལས་ ལས་འགན་ཚུ་ ལས་འགན་ཆུང་ཀུ་, འགན་འཁུར་པ་, ཁ་ཡིག་, ཚེས་གྲངས་, གཙོ་རིམ་དང་ དུས་ཚོད་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-nullboard": "Nullboard ནང་ བྱང་གཞི་ཁ་ཕྱེ་ ཐོ་བཀོད་ནང་ལས་ Export this board... གདམ་ .nbx ཡིག་སྣོད་འདི་ཚིག་ཡིག་ཞུན་དག་ཆས་ནང་ཁ་ཕྱེ་ཞིནམ་ལས་ དེ་གི་ནང་དོན་སྦྱར། ཐོ་ཡིག་ཚུ་ཐོ་ཡིག་ལུ་ ཟིན་ཐོ་ཚུ་ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། ཟིན་ཐོ་གི་གྲལ་ཐིག་དང་པ་འདི་ཤོག་བྱང་གི་མགོ་མིང་ དེ་ལས་ ལྷག་ལུས་འདི་འགྲེལ་བཤད་ཨིན། ཟིན་ཐོ་རེ་ཐོ་ལུ་ raw ཟེར་མི་ཁ་ཡིག་ཐོབ་འོང་། བྱང་གཞི་ལེ་ཤ་ཡོད་པའི་ཡིག་སྣོད་ཅིག་ལས་ བྱང་གཞི་དང་པ་ནང་འདྲེན་འབདཝ་ཨིན།",
  "import-board-instruction-kanri": "Kanri ནང་ Import & Export ཁ་ཕྱེ་ཞིནམ་ལས་ Export individual board (ཡང་ན་ Export all data) གདམ་ དེ་ལས་ .json ཡིག་སྣོད་འདི་སྦྱར། ཀ་ཐིག་ཚུ་ཐོ་ཡིག་ལུ་ ཤོག་བྱང་ཚུ་ འགྲེལ་བཤད་, དུས་ཚོད་ཚེས་, ཁ་ཡིག་དང་ ཚོས་གཞི་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། ཤོག་བྱང་གི་ལས་འགན་ཚུ་ ཞིབ་ཐོ་ལུ་འགྱུརཝ་ཨིན། གནད་སྡུད་ཆ་མཉམ་གྱི་ཕྱིར་སྐྱེལ་ལས་ བྱང་གཞི་དང་པ་ནང་འདྲེན་འབདཝ་ཨིན།",
  "import-board-instruction-pivotal": "Pivotal Tracker ནང་ ལས་འགུལ་གྱི་ MORE ཤོག་མཆོང་ཁ་ཕྱེ་ཞིནམ་ལས་ Export CSV གདམ་ (ཡང་ན་ story ཚུ་སེལ་འཐུ་འབད་ Bulk Actions, CSV གདམ་), དེ་ལས་ CSV འདི་སྦྱར། story གནས་སྟངས་རེ་རེ་ ཐོ་ཡིག་ལུ་འགྱུར་ཏེ་ story ཚུ་ དབྱེ་བ་དང་ཁ་ཡིག་, བདག་པོ་, ཞུ་བ་པ་, ཚེས་གྲངས་, བསམ་བཀོད་, ལས་འགན་དང་ བཀག་ཆ་ཚུ་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། Estimate འདི་ Story points ལུ་ དེ་ལས་ iteration ཚུ་ sprint ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-tasksorg": "Tasks.org ནང་ Settings, Backups ཁ་ཕྱེ་ཞིནམ་ལས་ Export tasks གདམ་ དེ་ལས་ .json ཡིག་སྣོད་དེ་གི་ནང་དོན་སྦྱར། ཐོ་ཡིག་ཚུ་ཐོ་ཡིག་ལུ་ ལས་འགན་ཚུ་ ཟིན་ཐོ་, ཁ་ཡིག་, ཚེས་གྲངས་, བསམ་བཀོད་དང་ ལས་འགན་ཆུང་ཀུ་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། མཇུག་བསྡུ་ཡོད་པའི་ལས་འགན་ཚུ་གིས་ མཇུག་བསྡུ་བའི་ཚེས་གྲངས་བཞག་ དེ་ལས་ གཙོ་རིམ་འདི་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-monday": "monday.com ནང་ བྱང་གཞིའི་ཐོ་བཀོད་ཁ་ཕྱེ་ More actions དང་ Export board to Excel གདམ་ (དགའ་བ་ཅིན་ updates དང་ subitems དང་གཅིག་ཁར་), དེ་ལས་ .xlsx ཡིག་སྣོད་དེ་གདམ། Status ཀ་ཐིག་འདི་ཐོ་ཡིག་ལུ་ སྡེ་ཚན་ཚུ་ཆུ་ལམ་ལུ་འགྱུརཝ་ཨིན། མི་, ཚེས་གྲངས་, དུས་ཚོད་ཐིག་དང་ ཁ་ཡིག་ཚུ་ས་གནས་ཁར་བཞག་ ཀ་ཐིག་གཞན་ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་ དེ་ལས་ updates ཚུ་བསམ་བཀོད་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-superproductivity": "Super Productivity ནང་ Settings ཁ་ཕྱེ་ཞིནམ་ལས་ Sync & Backup ནང་ Export Data གདམ་ དེ་ལས་ sp-backup .json ཡིག་སྣོད་ཀྱི་ནང་དོན་སྦྱར། ལས་འགུལ་རེ་རེ་ ཆུ་ལམ་ལུ་འགྱུར་ཏེ་ ལས་འགན་ཚུ་ To Do, In Progress, Backlog ཡང་ན་ Done ནང་ ཟིན་ཐོ་, ཁ་ཡིག་, དུས་ཚོད་ཚེས་, སྤྱོད་ཡོད་པའི་དུས་ཚོད་དང་ ལས་འགན་ཆུང་ཀུ་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། ཡིག་མཛོད་ལས་འགན་ཚུ་ ཡིག་མཛོད་ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-quire": "Quire ནང་ ལས་འགུལ་གྱི་ཐོ་བཀོད་ཁ་ཕྱེ་ Export CSV གདམ་ དེ་ལས་ CSV འདི་སྦྱར། གནས་སྟངས་ཚུ་ཐོ་ཡིག་ལུ་ ལས་འགན་ཚུ་ ལས་འགན་ཆུང་ཀུ་ཚུ་ཡན་ལག་ཤོག་བྱང་སྦེ་, འགན་འཁུར་པ་, ཁ་ཡིག་ཚུ་ཁ་ཡིག་སྦེ་, འགོ་བཙུགས་, དུས་ཚོད་དང་ མཇུག་བསྡུ་བའི་ཚེས་གྲངས་, འགྲེལ་བཤད་དང་ གཙོ་རིམ་འདི་སྒེར་གྱི་ས་སྒོ་སྦེ་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། བསམ་བཀོད་དང་མཉམ་སྦྲགས་ཚུ་ Quire གི་ CSV ནང་མེད།",
  "import-board-instruction-wrike": "Wrike ནང་ ལས་འགུལ་ ཡང་ན་ སྣོད་འཛིན་ཅིག་ Excel ལུ་ཕྱིར་སྐྱེལ་འབད་ ཡང་ན་ Wrike གི་ Excel ནང་འདྲེན་དཔེ་རིས་བཀང་ དེ་ལས་ .xlsx ཡིག་སྣོད་དེ་གདམ། སྣོད་འཛིན་དང་ལས་འགུལ་གྱི་གྲལ་ཐིག་ཚུ་ཆུ་ལམ་ལུ་ Status འདི་ཐོ་ཡིག་ལུ་ དེ་ལས་ ལས་འགན་ཚུ་ Key, ཕ་མའི་ལས་འགན་, འགན་འཁུར་པ་, འགོ་བཙུགས་དང་མཇུག་གི་ཚེས་གྲངས་, བརྟེན་པ་དང་ འགྲེལ་བཤད་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། Priority, Duration དང་ ཀ་ཐིག་གཞན་ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-teamwork": "Teamwork.com ནང་ Excel ལས་འགན་ནང་འདྲེན་དཔེ་རིས་ (Tasklist, Task, Description, Assign to, Start date, Due date, Priority, Estimated time, Tags, Status) བཀང་ཞིནམ་ལས་ .xlsx སྦེ་སྲུང་ དེ་ལས་ ཡིག་སྣོད་དེ་གདམ། ལས་འགན་ཐོ་ཡིག་ཚུ་ཐོ་ཡིག་ལུ་ ལས་འགན་ཚུ་ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། -, # ཡང་ན་ > གིས་འགོ་བཙུགས་མི་ལས་འགན་ཅིག་ དེ་གི་གོང་གི་ལས་འགན་གྱི་ལས་འགན་ཆུང་ཀུ་ལུ་འགྱུརཝ་ཨིན་ (--, ## ཡང་ན་ >> རིམ་པ་གཅིག་གཏིང་ཟབ་སུ་)། འགན་འཁུར་པ་, ཚེས་གྲངས་དང་ ཁ་ཡིག་ཚུ་ས་གནས་ཁར་བཞག་ Priority, Estimated time དང་ Complete ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-businessmap": "Businessmap (ཧེ་མ་ Kanbanize) ནང་ Advanced Search ཁ་ཕྱེ་ ཀ་ཐིག་ཚུ་གདམ་ནིའི་དོན་ལུ་ Configure results གདམ་ Excel ཡིག་སྣོད་ཕབ་ལེན་འབད་ དེ་ལས་ .xlsx ཡིག་སྣོད་དེ་གདམ། ཀ་ཐིག་ཚུ་ ཨིང་ལིཤ་མིང་ (Title, Column, Lane, Owner, Deadline ...) གིས་ལྷགཔ་ཨིན། ཁྱོད་ཀྱི་རྩིས་ཐོ་གིས་སྐད་ཡིག་གཞན་ལག་ལེན་འཐབ་པ་ཅིན་ ཧེ་མ་ར་ མགོ་ཡིག་གྲལ་ཐིག་འདི་ ཨིང་ལིཤ་ལུ་མིང་བསྒྱུར། Column འདི་ཐོ་ཡིག་ལུ་ Lane འདི་ཆུ་ལམ་ལུ་འགྱུརཝ་ཨིན། བདག་པོ་, ཁ་ཡིག་, ཚོས་གཞི་, ཚེས་གྲངས་, བསམ་བཀོད་དང་ ཕ་མའི་འབྲེལ་མཐུད་ཚུ་ས་གནས་ཁར་བཞག་ Priority, Size, Type དང་ ཀ་ཐིག་གཞན་ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-redmine": "Redmine ནང་ ལས་འགུལ་གྱི་ Issues ཁ་ཕྱེ་ ཐོ་ཡིག་གི་མཇུག་ལུ་ Also available in: CSV གདམ་ ཀ་ཐིག་ཚུ་ (All columns, Description དང་གཅིག་ཁར་) གདམ་ཞིནམ་ལས་ ཕྱིར་སྐྱེལ་འབད་ དེ་ལས་ CSV འདི་སྦྱར། Redmine གིས་ ཀ་ཐིག་ཚུ་ཁྱོད་ཀྱི་སྐད་ཡིག་ནང་མིང་བཏགསཔ་ཨིན་ དེ་འབདཝ་ལས་ ཕྱིར་སྐྱེལ་མ་འབད་བའི་ཧེ་མ་ My account ནང་ ཁྱོད་ཀྱི་སྐད་ཡིག་འདི་ ཨིང་ལིཤ་ལུ་གཞི་སྒྲིག་འབད། གནས་སྟངས་རེ་རེ་ ཐོ་ཡིག་ལུ་འགྱུར་ཏེ་ གནད་དོན་ཚུ་ tracker འདི་ཁ་ཡིག་སྦེ་, འགན་འཁུར་པ་, རྩོམ་པ་པོ་, ཚེས་གྲངས་, ཕ་མའི་ལས་འགན་དང་ འབྲེལ་བ་ཡོད་པའི་གནད་དོན་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། གཙོ་རིམ་, དབྱེ་ཁག་, དམིགས་གཏད་ཐོན་རིམ་, ཚོད་རྩིས་དུས་ཚོད་, % Done དང་ སྒེར་གྱི་ས་སྒོ་ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-orgmode": "Emacs, Orgzly ཡང་ན་ Beorg གིས་འབྲི་དོ་བཟུམ་གྱི་ Org mode ཡིག་སྣོད་ཅིག་སྦྱར། གོང་རིམ་གྱི་མགོ་ཡིག་ཚུ་ཐོ་ཡིག་ལུ་འགྱུར་ཏེ་ རིམ་པ་གཉིས་པའི་མགོ་ཡིག་ཚུ་ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། TODO དང་ DONE, གཙོ་རིམ་, ཁ་ཡིག་, SCHEDULED, DEADLINE དང་ CLOSED ཚུ་བཞག་འོང་ དེ་ལས་ ཞིབ་རྟགས་སྒྲོམ་དང་ གཏིང་ཟབ་པའི་མགོ་ཡིག་ཚུ་ཞིབ་ཐོ་ལུ་འགྱུརཝ་ཨིན།",
  "import-board-instruction-focalboard": ".boardarchive ཡིག་སྣོད་ཀྱི་སྡུད་སྒྲིལ་བཤིག་སྟེ་ བྱང་གཞིའི་ board.jsonl སྦྱར། ཐོན་རིམ་གྱི་གྲལ་ཐིག་ཡོད་རུང་མེད་རུང་བཏུབ། བྱང་གཞི་མཐོང་སྣང་གི་སྡེ་ཚན་བཟོ་ནིའི་ཁྱད་ཆོས་དེ་ཐོ་ཡིག་ལུ་འགྱུརཝ་ཨིན། གདམ་ཁ་རྐྱབ་ནིའི་ཁྱད་ཆོས་གཞན་ཚུ་ཁ་ཡིག་ལུ་འགྱུརཝ་ཨིན། ཚིག་ཡིག་དང་རྟགས་བཀལ་སྒྲོམ་གྱི་དུམ་བུ་ཚུ་འགྲེལ་བཤད་དང་ཞིབ་དཔྱད་ཐོ་ཡིག་ལུ་འགྱུརཝ་ཨིནམ་དང་ བསམ་འཆར་ཚུ་བཞགཔ་ཨིན། པར་དང་ཟུར་སྦྲགས་ཚུ་ནང་འདྲེན་མི་འབད།",
  "import-board-instruction-todoist": "In Todoist, open the project menu and choose Export as a template, then paste the CSV file. Sections become lists, tasks become cards, sub-tasks become a checklist, notes become comments, and @labels and priorities p1 to p3 become labels.",
  "csv-mapping-title": "ཀ་ཐིག་ག་འདི་ག་ཅི་ཨིན?",
  "csv-mapping-description": "ཤོག་བྱང་ས་སྒོ་རེ་རེ་འཆང་མི་ ཡིག་སྣོད་ཀྱི་ཀ་ཐིག་འདི་གདམ། གདམ་ཁ་ཚུ་ ཀ་ཐིག་གི་མིང་ལས་བཟོ་ཡོདཔ་ཨིན། ནོར་བ་ག་ཅི་ཡོད་རུང་བསྒྱུར་ དེ་ལས་ ཡིག་སྣོད་ནང་མེད་པའི་ས་སྒོ་ཅིག་གི་དོན་ལུ་ (ཡིག་སྣོད་ནང་མེད) གདམ།",
  "csv-mapping-not-in-file": "(ཡིག་སྣོད་ནང་མེད)",
  "csv-mapping-column-number": "ཀ་ཐིག་ __number__",
  "csv-mapping-list-missing": "ཡིག་སྣོད་ནང་ ཐོ་ཡིག་གི་དོན་ལུ་ཀ་ཐིག་མེད། གོང་ལས་ཅིག་གདམ་ ཡང་ན་ ཤོག་བྱང་ག་ར་འགྱོ་སའི་ཐོ་ཡིག་གཅིག་གི་མིང་ཡིག་དཔར་རྐྱབ།",
  "csv-mapping-list-name": "ཤོག་བྱང་ག་ར་གི་དོན་ལུ་ཐོ་ཡིག",
  "csv-mapping-custom-fields": "ཚིག་ཡིག་སྒེར་གྱི་ས་སྒོ་སྦེ་ནང་འདྲེན་འབད་ནིའི་ཀ་ཐིག་གཞན་ཚུ།",
  "csv-mapping-boards": "ཤོག་ལེབ་རེ་རེ་ རང་སོའི་བྱང་གཞི་ལུ་འགྱུརཝ་ཨིན།",
  "csv-mapping-skipped-sheets": "ནང་འདྲེན་མ་འབད་བའི་ཤོག་ལེབ་ཚུ།",
  "csv-mapping-title-required": "ཤོག་བྱང་གི་མགོ་མིང་ཚུ་འཆང་མི་ཀ་ཐིག་འདི་གདམ།",
  "csv-mapping-list-required": "ཤོག་བྱང་ག་ར་འགྱོ་སའི་ཐོ་ཡིག་གི་མིང་ཡིག་དཔར་རྐྱབ་ ཡང་ན་ ཐོ་ཡིག་འཆང་མི་ཀ་ཐིག་འདི་གདམ།",
  "import-board-instruction-planner": "In Microsoft Planner, open the plan's menu and choose Export plan to Excel, then choose that .xlsx file. Buckets become lists and tasks become cards, with their assignees, dates, labels, checklist and description; Progress, Priority and Completed By become custom fields.",
  "import-board-instruction-vikunja": "Vikunja ནང་ Settings ཁ་ཕྱེ་ Data Export གདམ་ཞིནམ་ལས་ ཁྱོད་ལུ་གཏང་མི་ .zip ཡིག་སྣོད་ཕབ་ལེན་འབད་ དེ་ལས་ ཡིག་སྣོད་དེ་གདམ་ ཡང་ན་ དེ་གི་ནང་གི་ data.json སྦྱར། Kanban bucket ཚུ་ཐོ་ཡིག་ལུ་ ལས་འགན་ཚུ་ ཁ་ཡིག་, འགན་འཁུར་པ་, ཚེས་གྲངས་, འགྲེལ་བཤད་, ལས་འགན་ཐོ་ཡིག་ཚུ་ཞིབ་ཐོ་སྦེ་ དེ་ལས་ བསམ་བཀོད་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། གཙོ་རིམ་, བརྒྱ་ཆ་མཇུག་བསྡུ་ཡོདཔ་དང་ མཇུག་བསྡུ་ཡོདཔ་ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན། མཉམ་སྦྲགས་ཚུ་ནང་འདྲེན་མི་འབད།",
  "import-board-instruction-notion": "Notion ནང་ གནད་སྡུད་གཞི་རྟེན་འདི་ ཤོག་ལེབ་ཧྲིལ་བུམ་སྦེ་ཁ་ཕྱེ་ ••• དང་ Export གདམ་ Markdown & CSV གདམ་ཞིནམ་ལས་ ཕབ་ལེན་འབད་མི་ .zip ཡིག་སྣོད་ ཡང་ན་ དེ་གི་ནང་ལས་ གནད་སྡུད་གཞི་རྟེན་ CSV ཅིག་གདམ་ ཡང་ན་ CSV དེ་སྦྱར། Status ཟེར་མིང་བཏགས་མི་ཀ་ཐིག་ཅིག་ ཐོ་ཡིག་ལུ་འགྱུརཝ་ཨིན་ (དེ་མེད་པ་ཅིན་ select བཟུམ་སྦེ་མཐོང་མི་ཀ་ཐིག་དང་པ་འདི་ ནང་འདྲེན་སྙན་ཞུ་ནང་ག་འདི་ཨིན་ན་སྟོནམ་ཨིན་)། གྲལ་ཐིག་ཚུ་ མགོ་མིང་, ཁ་ཡིག་, མི་ཚུ་འཐུས་མི་སྦེ་, ཚེས་གྲངས་དང་ ཤོག་ལེབ་ཀྱི་ཚིག་ཡིག་འདི་འགྲེལ་བཤད་སྦེ་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། ཀ་ཐིག་གཞན་ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན། འབྲེལ་བ་, པར་དང་ མཉམ་སྦྲགས་ཚུ་ནང་འདྲེན་མི་འབད།",
  "import-board-instruction-plane": "Plane ནང་ Workspace Settings ཁ་ཕྱེ་ Exports གདམ་ ལས་འགུལ་ཚུ་ JSON, CSV ཡང་ན་ Excel སྦེ་ཕྱིར་སྐྱེལ་འབད་ .zip ཡིག་སྣོད་ཕབ་ལེན་འབད་ དེ་ལས་ ཡིག་སྣོད་དེ་ ཡང་ན་ དེ་གི་ནང་གི་ཡིག་སྣོད་ཅིག་གདམ་ ཡང་ན་ JSON ཡང་ན་ CSV སྦྱར། གནས་སྟངས་ཚུ་ཐོ་ཡིག་ལུ་ ལས་འགུལ་ཚུ་ཆུ་ལམ་ལུ་ དེ་ལས་ གནད་དོན་ཚུ་ ངོས་འཛིན་, ཕ་མ་, འགན་འཁུར་པ་, ཁ་ཡིག་, ཚེས་གྲངས་, འབྲེལ་མཐུད་དང་ བསམ་བཀོད་དང་གཅིག་ཁར་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན། གཙོ་རིམ་, ཚོད་རྩིས་, འཁོར་རིམ་དང་ module ཚུ་ སྒེར་གྱི་ས་སྒོ་ལུ་འགྱུརཝ་ཨིན། Plane གི་ཕྱིར་སྐྱེལ་ནང་ འགྲེལ་བཤད་དང་མཉམ་སྦྲགས་མེདཔ་ལས་ དེ་ཚུ་ནང་འདྲེན་མི་འབད།",
  "import-board-instruction-taiga": "Taiga ནང་ Admin > Project > Export ཁ་ཕྱེ་ཞིནམ་ལས་ ལས་འགུལ་གྱི་ dump ཕབ་ལེན་འབད་ (.json.gz ཡིག་སྣོད་ཅིག་ཧེ་མ་ར་ཁ་ཕྱེ་), དེ་ལས་ དེ་གི་ JSON སྦྱར། User story གནས་སྟངས་ཚུ་ཐོ་ཡིག་ལུ་ user story ཚུ་ ལས་འགན་ཚུ་ལས་འགན་ཆུང་ཀུ་སྦེ་ ཤོག་བྱང་ལུ་འགྱུརཝ་ཨིན་ epic དང་ གནད་དོན་ཚུ་ལུ་ རང་སོའི་ཆུ་ལམ་ཐོབ་ དེ་ལས་ sprint, ཁ་ཡིག་, བསམ་བཀོད་དང་ སྒེར་གྱི་ཁྱད་ཆོས་ཚུ་ཡང་འོང་། མཉམ་སྦྲགས་ཚུ་ནང་འདྲེན་མི་འབད།"
}