  "migrations-admin-only": "བྱང་གཞིའི་བདག་སྐྱོང་པ་ཁོ་ནས་སྤོ་སྒྱུར་འགོ་སློང་ཆོག",
  "migrations-description": "བྱང་གཞི་འདིར་གཞི་གྲངས་ཆ་ཚང་གནས་པའི་ཞིབ་བཤེར་དང་ཉམས་གསོ་འགོ་སློང་། སྤོ་སྒྱུར་རེ་རེ་ལོགས་སུ་ལག་བསྟར་བྱེད་ཆོག",
  "no-issues-found": "གནད་དོན་མ་རྙེད།",
  "run-migration": "སྤོ་སྒྱུར་འགོ་སློང་།",
  "run-comprehensive-migration-confirm": "འདིས་བྱང་གཞིའི་གཞི་གྲངས་ཆ་ཚང་གནས་པ་ཞིབ་བཤེར་དང་ཉམས་གསོ་བྱེད་པར་སྤོ་སྒྱུར་ཆ་ཚང་ཞིག་བྱེད། དུས་ཡུན་ཅུང་ཙམ་འགོར་སྲིད། མུ་མཐུད་དམ།",
  "run-delete-duplicate-empty-lists-migration-confirm": "འདིས་སྔོན་ལ་མཉམ་སྤྱོད་ཐོ་གཞུང་གང་རུང་ཆུ་ལམ་རེའི་ཐོ་གཞུང་དུ་བསྒྱུར་ནས། མིང་གཅིག་པའི་ཤོག་བྱང་ཡོད་པའི་བསྐྱར་ཟློས་ཐོ་གཞུང་ཡོད་པའི་སྟོང་པའི་ཐོ་གཞུང་སུབ། དངོས་སུ་མི་དགོས་པའི་སྟོང་པའི་ཐོ་གཞུང་ཁོ་ན་བཏོན། མུ་མཐུད་དམ།",
  "run-restore-lost-cards-migration-confirm": "འདིས་ 'བརླག་པའི་ཤོག་བྱང་' ཆུ་ལམ་ཞིག་གསར་བཟོ་ནས་ swimlaneId ཡང་ན་ listId མེད་པའི་ཤོག་བྱང་དང་ཐོ་གཞུང་ཚང་མ་སླར་གསོ། འདིས་ཡིག་མཛོད་མིན་པའི་རྣམ་གྲངས་ཁོ་ནར་ཕོག མུ་མཐུད་དམ།",
  "run-restore-all-archived-migration-confirm": "འདིས་ཡིག་མཛོད་ཀྱི་ཆུ་ལམ། ཐོ་གཞུང་དང་ཤོག་བྱང་ཚང་མ་སླར་གསོ་ནས་ཡང་བསྐྱར་མཐོང་བར་བཟོ། ID མེད་པའི་རྣམ་གྲངས་གང་རུང་རང་འགུལ་གྱིས་ཉམས་གསོ་བྱེད། འདི་སླ་བོར་ཕྱིར་བཤིག་མི་ཐུབ། མུ་མཐུད་དམ།",
