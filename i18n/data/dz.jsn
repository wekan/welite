  "restore-lost-cards-migration": "བརླག་པའི་ཤོག་བྱང་སླར་གསོ།",
  "restore-lost-cards-migration-description": "swimlaneId ཡང་ན་ listId མེད་པའི་ཤོག་བྱང་དང་ཐོ་གཞུང་འཚོལ་ནས་སླར་གསོ་བྱེད། བརླག་པའི་རྣམ་གྲངས་ཚང་མ་ཡང་བསྐྱར་མཐོང་བར་ 'བརླག་པའི་ཤོག་བྱང་' ཆུ་ལམ་ཞིག་གསར་བཟོ།",
  "restore-all-archived-migration": "ཡིག་མཛོད་ཀྱི་ཚང་མ་སླར་གསོ།",
  "restore-all-archived-migration-description": "ཡིག་མཛོད་ཀྱི་ཆུ་ལམ། ཐོ་གཞུང་དང་ཤོག་བྱང་ཚང་མ་སླར་གསོ། རྣམ་གྲངས་མཐོང་བར་ swimlaneId ཡང་ན་ listId མེད་པ་གང་རུང་རང་འགུལ་གྱིས་ཉམས་གསོ་བྱེད།",
