  "password-length-report-desc": "ཉུང་ཤོས་རིང་ཚད་ལས་ཐུང་བའི་ཆོག་ཡིག་གིས་ནང་བསྐྱོད་འབད་མི་རྩིས་ཐོ་ཚུ། ཆོག་ཡིག་ག་དེམ་ཅིག་རིངམ་ཨིན་ན་ བརྡ་འཚོལ་བ་ཁོ་རྐྱངམ་གཅིག་གིས་ཤེས་ནི་ཨིན་མི་ལས་ ནང་བསྐྱོད་འབད་བའི་ཤུལ་ལས་ ཐུང་བ་ཅིན་སྙན་ཞུ་འབདཝ་ཨིན། ཆོག་ཡིག་དང་དེའི་རིང་ཚད་ནམ་ཡང་ཕྱི་ཁར་མི་འགྱོ། བཅོས་ཡོདཔ་ཟེར་མི་འདི་ རྩིས་ཐོའི་ཆོག་ཡིག་བསྒྱུར་བའི་དུས་ཚོད་ཨིན། ཆོག་ཡིག་ཐུང་བ་གིས་ལོག་སྟེ་ནང་བསྐྱོད་འབད་མི་རྩིས་ཐོ་འདི་ ལོག་སྟེ་ཐུང་དྲགས་སྦེ་སྟོནམ་ཨིན།",
  "password-length-saved": "སྲུང་ཡོདཔ།",
  "password-min-length": "ཆོག་ཡིག་གི་ཉུང་ཤོས་རིང་ཚད།",
  "password-min-length-description": "ཆོག་ཡིག་ཐུང་བ་གིས་ནང་བསྐྱོད་འབད་མི་ཚུ་ འོག་ལུ་ཐོ་བཀོད་འབདཝ་ཨིན། དེ་གི་དོན་ལུ་ནང་བསྐྱོད་ནམ་ཡང་མི་བཀག",
  "password-min-length-enforce": "ཉུང་ཤོས་རིང་ཚད་བཙན་ཐབས་འབད།",
  "password-min-length-enforce-description": "ཆོག་ཡིག་གསརཔ་ཐུང་བ་ཅིན་ ངོས་ལེན་མི་འབད། ཆོག་ཡིག་ཐུང་བ་གིས་ནང་བསྐྱོད་འབད་མི་རྩིས་ཐོ་གིས་ ག་ཅི་ཨིན་རུང་མ་འབད་བའི་ཧེ་མ་ བསྒྱུར་དགོ། བསྒྱུར་བ་ཅིན་ རྩིས་ཐོའི་ལཱ་ཡུན་ཆ་མཉམ་ཕྱིར་ཐོན་འབདཝ་ཨིན། LDAP, OAuth2, OIDC, SAML, CAS དང་ Sandstorm གི་ཆོག་ཡིག་ཚུ་ དེ་ཚུ་གི་བྱིན་མཁན་གྱི་ཨིན་ནི་དང་ ཞིབ་དཔྱད་མི་འབད།",
  "password-change-required-text": "ས་ཁོངས་འདི་གིས་ད་ལྟོ་ ཉུང་ཤོས་ཡིག་འབྲུ་ __min__ གི་ཆོག་ཡིག་དགོཔ་ཨིན་ ཁྱོད་ཀྱི་འདི་ཐུང་བས། མུ་མཐུད་ནི་ལུ་ རིངམ་ཅིག་གདམ་ཁ་རྐྱབ། དེ་ལས་ ཁྱོད་ཀྱི་རྩིས་ཐོའི་ལཱ་ཡུན་ཆ་མཉམ་ཕྱིར་ཐོན་འབད་འོང་ ཆོག་ཡིག་གསརཔ་གིས་ལོག་སྟེ་ནང་བསྐྱོད་འབད།",
  "date-format-for-everyone": "ག་ར་གི་དོན་ལུ་ཚེས་གྲངས་རྩ་སྒྲིག",
  "calendar-system": "ཟླ་ཐོ",
  "show-unread-changes": "ང་གིས་མཇུག་མཐའ་ཁ་ཕྱེ་ཞིནམ་ལས་བསྒྱུར་བཅོས་འབད་མི་ཤོག་བྱང་ཚུ་ལུ་རྟགས་བཀལ།",
  "show-unread-changes-desc": "ཁྱོད་ཀྱིས་མཇུག་མཐའ་ཁ་ཕྱེ་ཞིནམ་ལས་ མགོ་མིང་དང་ འགྲེལ་བཤད་ ཚེས་གྲངས་ ཁ་ཡིག་ འཐུས་མི་ ཞིབ་དཔྱད་ཐོ་ཡིག་ མཉམ་སྦྲགས་ ཡང་ན་ བསམ་བཀོད་ཚུ་བསྒྱུར་བཅོས་འབད་མི་ཤོག་བྱང་འདི་ ཁྱོད་ཀྱིས་ཁ་མ་ཕྱེ་ཚུན་ ཤོག་བྱང་ཆུང་ཀུའི་ཐོག་ལུ་ མཐའ་མ་སྔོནམ་ཅིག་ཐོབ་འོང་།",
  "keep-title-tags": "ཤོག་བྱང་གསརཔ་གི་མགོ་མིང་ནང་ #ཁ་ཡིག་དང་ @འཐུས་མི་ བཞག།",
  "keep-title-tags-description": "ཤོག་བྱང་གསརཔ་གི་མགོ་མིང་ཡིག་དཔར་རྐྱབ་པའི་སྐབས་ # གིས་ཁ་ཡིག་ཡང་ན་ @ གིས་འཐུས་མི་གདམ་ཁ་རྐྱབ་པ་ཅིན་ ཡིག་འབྲུ་དེ་ཡང་མགོ་མིང་ནང་བཞག། ཁ་བསྡམས་: ཡིག་འབྲུ་དེ་ཁ་ཡིག་ཡང་ན་འཐུས་མི་གིས་ཚབ་བཙུགས་འོང་།",
  "show-focus-outline": "ཕོ་ཀསི་གི་མཐའ་ཐིག་སྟོན།",
  "keep-add-card-form-open": "ཤོག་བྱང་ཁ་སྐོང་བརྐྱབ་ཞིནམ་ལས་ ཤོག་བྱང་ཁ་སྐོང་གི་འགང་ཤོག་ཁ་ཕྱེ་སྟེ་བཞག",
  "keep-add-card-form-open-description": "ཁ་ཕྱེ་: ཤོག་བྱང་ཁ་སྐོང་བརྐྱབ་ཞིནམ་ལས་ འགང་ཤོག་འདི་ ཤོག་བྱང་ཤུལ་མམ་གྱི་དོན་ལུ་ མགོ་མིང་སྟོངམ་དང་གཅིག་ཁར་ ཁ་ཕྱེ་སྟེ་སྡོདཔ་ཨིན། ཁ་བསྡམས་: ཤོག་བྱང་ཁ་སྐོང་བརྐྱབ་ཚར་བའི་ཤུལ་ལས་ འགང་ཤོག་འདི་ཁ་བསྡམསཔ་ཨིན།",
  "title-bracket-label": "ཤོག་བྱང་གསརཔ་གི་མགོ་མིང་འགོ་ལུ་ཡོད་པའི་[ཁ་ཡིག་]ཁ་ཡིག་ལུ་བསྒྱུར།",
  "title-bracket-label-description": "ཤོག་བྱང་གསརཔ་གི་མགོ་མིང་[ཡིག་འབྲུ]གིས་འགོ་བཙུགས་ཏེ་ཤུལ་ལུ་ཡིག་འབྲུ་གཞན་ཡོད་པ་ཅིན་ ཡིག་འབྲུ་དེ་ཤོག་བྱང་གི་ཁ་ཡིག་ལུ་འགྱུར་འོང་ (པད་ཤིང་ནང་མིང་དེ་གི་ཁ་ཡིག་མེད་པ་ཅིན་གསརཔ་བཟོ་འོང་) དེ་ལས་མགོ་མིང་ནང་ལས་བཏོན་འོང་། ཁ་བསྡམས་: མགོ་མིང་ཡོད་དོ་བཟུམ་སྦེ་བཞག་འོང་།",
  "submit-on-enter": "Enter མནན་ནས་རྩོམ་སྒྲིག་ཕུལ།",
  "submit-on-enter-description": "སྤར་ཡོད་སྐབས་ Enter མནན་ན་ཤོག་བྱང་ཁ་བྱང་། འགྲེལ་བཤད་དང་ཐིག་ཕྲེང་ནང་གི་རྩོམ་སྒྲིག་གཞན་རྣམས་ཉར་ཚགས་བྱེད། Shift+Enter གྱིས་ཐིག་ཕྲེང་གསར་པ་ཞིག་འཇུག སྤར་མེད་སྐབས་ Ctrl/Cmd+Enter གྱིས་ཉར་ཚགས་བྱེད་པ་དང་ Enter གྱིས་ཐིག་ཕྲེང་གསར་པ་འཇུག",
  "open-many-cards-at-once": "ཤོག་བྱང་མང་པོ་དུས་གཅིག་ཏུ་ཁ་ཕྱེ།",
  "open-many-cards-at-once-description": "ཁྱེད་ཀྱིས་མནན་པའི་ཤོག་བྱང་རེ་རེ་རང་གི་སྒེའུ་ཁུང་ནང་ཁ་ཕྱེ་ནས་ཞོག འདི་སྤར་མེད་སྐབས་ཤོག་བྱང་ཞིག་མནན་ན་ཁ་ཕྱེ་ཡོད་པ་དེ་ཁ་རྒྱག",
  "checklist-ding-sound": "ཞིབ་དཔྱད་ཐོ་ཡིག་གི་ཆ་ཤས་ཅིག་མཇུག་བསྡུ་བའི་སྐབས་སྒྲ་སྒྲོགས།",
  "checklist-ding-sound-description": "ཞིབ་དཔྱད་ཐོ་ཡིག་གི་ཆ་ཤས་ཅིག་དཔྱད་ཞིབ་བྱེད་སྐབས་སྒྲ་ཐུང་ཀུ་ཅིག་སྒྲོགས། སྔོན་སྒྲིག་ནང་མེད།",
