  "globalSearch-instructions-operator-number": "`__operator_number__:<number>` - ཤོག་བྱང་ཨང་གྲངས་ *<number>* ཡིན་པའི་ཤོག་བྱང་།",
  "subtask-inherit-parent-labels": "ཕ་མའི་ཡིག་ཆའི་ལེབལ་ཤུལ་བཞིན་ལེན།",
  "subtask-mark-done": "ལས་འགན་ཆུང་ཀུ་ མཇུག་བསྡུ་ཡི་ཟེར་རྟགས་བཀལ།",
  "subtask-mark-not-done": "ལས་འགན་ཆུང་ཀུ་ མཇུག་མ་བསྡུ་ཟེར་རྟགས་བཀལ།",
  "subtask-done-no-permission": "ལས་འགན་ཆུང་ཀུ་འདི་ མཇུག་བསྡུ་ཡོད་མེད་ ཁྱོད་ཀྱིས་བསྒྱུར་མི་ཚུགས།",
  "board-view-calendar-mode": "ཟླ་ཐོའི་ཐབས་ལམ།",
