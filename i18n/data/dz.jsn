  "import-board-instruction-deck": "NextCloud Deck བྱང་གཞི་ JSON སྦྱར་ (\"stacks\" ཡོད་པའི་བྱང་གཞི་དང་རིམ་པ་རེ་ལུ་ \"cards\" ཡོད།) རིམ་པ་ཚུ་ཐོ་ཡིག་དང་ཤོག་བྱང་ཚུ་ཤོག་བྱང་འགྱོ་འོང་།",
  "import-board-instruction-openproject": "OpenProject ལཱ་ཐུམ་ JSON བསྡུ་གསོག་སྦྱར་ (GET /api/v3/work_packages). གནས་སྟངས་ཚུ་ཐོ་ཡིག་དང་ལཱ་ཐུམ་ཚུ་ཤོག་བྱང་འགྱོ་འོང་།",
  "import-board-instruction-issues": "__sourceName__ གི་དཀའ་ངལ་ JSON རིམ་ཚན་ (__endpoint__) སྦྱར། དཀའ་ངལ་ཚུ་ཁ་ཕྱེ་ / ཁ་བསྡམ་ཐོ་ཡིག་ནང་སྡེ་ཚན་བཟོ་བའི་ཤོག་བྱང་འགྱོ་འོང་།",
  "import-board-instruction-asana": "Asana ལས་འགན་ཕྱིར་འདྲེན་ JSON སྦྱར་ ({ \"data\": [...] } Asana ཕྱིར་འདྲེན་ཡང་ན་ GET /tasks ལས་) ལས་འགན་ཚུ་དབྱེ་ཚན་ (memberships) ནང་སྡེ་ཚན་བཟོ་འོང་། མཇུག་བསྡུ་བའི་ལས་འགན་ཚུ་འགྲུབ་ལུ་འགྱོ་འོང་།",
  "import-board-instruction-zenkit": "ZenKit ཐོ་ཡིག་ཕྱིར་འདྲེན་ JSON སྦྱར་ ({ \"title\", \"stages\":[...], \"items\":[...] }). གནས་རིམ་ཚུ་ཐོ་ཡིག་དང་དོན་ཚན་ཚུ་ཤོག་བྱང་འགྱོ་འོང་།",
  "import-board-instruction-trello": "ཁྱོད་ཀྱི་ Trello བྱང་གཞི་ནང་ 'Menu', 'More', 'Print and Export', 'Export JSON' ལུ་འགྱོ་ཞིནམ་ལས་ཐོབ་པའི་ཚིག་ཡིག་འདྲ་བཤུས་འབད།",
  "import-board-instruction-csv": "Comma Separated Values (CSV)/Tab Separated Values (TSV) སྦྱར།",
  "import-board-instruction-jira": "Jira Cloud REST API དཀའ་ངལ་འཚོལ་ཞིབ་ལས་ JSON སྦྱར་ (GET /rest/api/3/search/jql), ཡང་ན་འདྲ་མཉམ་ { \"issues\": [...] } དངོས་པོ། Jira གནས་སྟངས་ཚུ་ཐོ་ཡིག་དང་དཀའ་ངལ་ཚུ་ཤོག་བྱང་འགྱོ་འོང་། ལམ་ལུགས་ནང་འདྲེན་འབད་ནི་ལུ་ \"automationRules\" རིམ་ཚན་གདམ་ཁ་ཅན་སྦེ་བཙུགས་ཚུགས།",
  "import-board-instruction-excel": "WeKan བཟོ་རྣམ་གྱི་ .xlsx ཐིག་ཁྲམ་གདམ་ཁ་རྐྱབ་ (Excel ཕྱིར་འདྲེན་དང་ཀེར་ཐིག་གཅིག་པ། Title, Description, Status/List, Members, Labels, dates, custom fields). གྲལ་ཐིག་དང་པ་འདི་མགོ་ཡིག་ཨིན།",
  "import-excel-file": "Excel ཡིག་སྣོད་ (.xlsx)",
  "import-board-instruction-wekan": "ཁྱོད་ཀྱི་བྱང་གཞི་ནང་ 'Menu', 'Export board' ལུ་འགྱོ་ཞིནམ་ལས་ཕབ་ལེན་འབད་བའི་ཡིག་སྣོད་ཀྱི་ཚིག་ཡིག་འདྲ་བཤུས་འབད།",
  "import-board-instruction-about-errors": "བྱང་གཞི་ནང་འདྲེན་སྐབས་འཛོལ་བ་ཐོབ་རུང་ རེ་ཚེ་ནང་འདྲེན་ལཱ་འབད་འོང་། བྱང་གཞི་འདི་བྱང་གཞི་ཆ་མཉམ་གྱི་ཤོག་ལེབ་གུ་ཡོད།",
  "import-without-mapping-members": "འཐུས་མི་སྦྱོར་བ་མེད་པར་ནང་འདྲེན་འབད་ (ཤུལ་ལས་སྦྱོར།)",
