  "previous-page": "ཤོག་ངོས་སྔོན་མ།",
  "heading-notes": "དྲན་ཐོ།",
  "globalSearch-instructions-heading": "འཚོལ་ཞིབ་བཀོད་ཁྱབ།",
  "globalSearch-instructions-description": "འཚོལ་ཞིབ་ཞིབ་ཕྲ་བཟོ་བར་བཀོལ་རྟགས་འཇུག་ཆོག བཀོལ་རྟགས་མིང་དང་རིན་ཐང་བར་གཉིས་རྟགས་ཀྱིས་ཕྱེ་ནས་འབྲི། དཔེར་ན་ `list:Blocked` གིས་ *Blocked* མིང་ཅན་གྱི་ཐོ་གཞུང་ནང་གི་ཤོག་བྱང་ཁོ་ནར་འཚོལ་ཞིབ་ཚད་འཛིན་བྱེད། རིན་ཐང་ནང་སྟོང་ཆའམ་དམིགས་བསལ་ཡིག་འབྲུ་ཡོད་ན་འདྲེན་རྟགས་ནང་འཇུག་དགོས། (དཔེར་ན་ `__operator_list__:\"To Review\"`)",
  "globalSearch-instructions-operators": "སྤྱོད་ཆོག་པའི་བཀོལ་རྟགས།",
  "globalSearch-instructions-operator-board": "`__operator_board__:<title>` - གསལ་བཀོད་ *<title>* དང་མཐུན་པའི་བྱང་གཞི་ནང་གི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-list": "`__operator_list__:<title>` - གསལ་བཀོད་ *<title>* དང་མཐུན་པའི་ཐོ་གཞུང་ནང་གི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-swimlane": "`__operator_swimlane__:<title>` - གསལ་བཀོད་ *<title>* དང་མཐུན་པའི་ཆུ་ལམ་ནང་གི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-comment": "`__operator_comment__:<text>` - *<text>* ཡོད་པའི་བསམ་བཀོད་དང་ལྡན་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-label": "`__operator_label__:<color>` `__operator_label__:<name>` - *<color>* ཡང་ན་ *<name>* དང་མཐུན་པའི་ཁ་བྱང་ཡོད་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-hash": "`__operator_label_abbrev__<name|color>` - `__operator_label__:<color>` ཡང་ན་ `__operator_label__:<name>` གི་བསྡུས་རྟགས།",
  "globalSearch-instructions-operator-user": "`__operator_user__:<username>` - *<username>* ནི་ *ཚོགས་མི* ཡང་ན་ *ལས་བགོས་མི* ཡིན་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-at": "`__operator_user_abbrev__username` - `user:<username>` གི་བསྡུས་རྟགས།",
  "globalSearch-instructions-operator-member": "`__operator_member__:<username>` - *<username>* ནི་ *ཚོགས་མི* ཡིན་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-assignee": "`__operator_assignee__:<username>` - *<username>* ནི་ *ལས་བགོས་མི* ཡིན་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-creator": "`__operator_creator__:<username>` - *<username>* ནི་ཤོག་བྱང་གསར་བཟོ་པ་ཡིན་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-org": "`__operator_org__:<display name|short name>` - *<name>* ལས་སྡེར་ལས་བགོས་བྱས་པའི་བྱང་གཞི་ལ་གཏོགས་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-team": "`__operator_team__:<display name|short name>` - *<name>* རུ་ཁག་ལ་ལས་བགོས་བྱས་པའི་བྱང་གཞི་ལ་གཏོགས་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-due": "`__operator_due__:<n>` - ད་ལྟ་ནས་ཉིན་ *<n>* ནང་དུས་བཀག་ཡོད་པའི་ཤོག་བྱང་། `__operator_due__:__predicate_overdue__` གིས་དུས་བཀག་ཡོལ་བའི་ཤོག་བྱང་ཚང་མ་སྟོན།",
  "globalSearch-instructions-operator-created": "`__operator_created__:<n>` - ཉིན་ *<n>* སྔོན་ནམ་ཉུང་བའི་ནང་གསར་བཟོ་བྱས་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-modified": "`__operator_modified__:<n>` - ཉིན་ *<n>* སྔོན་ནམ་ཉུང་བའི་ནང་བསྒྱུར་བའི་ཤོག་བྱང་།",
  "globalSearch-instructions-operator-status": "`__operator_status__:<status>` - *<status>* ནི་གཤམ་གསལ་གཅིག་ཡིན།",
  "globalSearch-instructions-status-archived": "`__predicate_archived__` - ཡིག་མཛོད་ཀྱི་ཤོག་བྱང་།",
  "globalSearch-instructions-status-all": "`__predicate_all__` - ཡིག་མཛོད་དང་ཡིག་མཛོད་མིན་པའི་ཤོག་བྱང་ཚང་མ།",
  "globalSearch-instructions-status-ended": "`__predicate_ended__` - མཇུག་སྒྲིལ་ཚེས་གྲངས་ཡོད་པའི་ཤོག་བྱང་།",
  "globalSearch-instructions-status-public": "`__predicate_public__` - མི་མང་བྱང་གཞིའི་ཤོག་བྱང་ཁོ་ན།",
  "globalSearch-instructions-status-private": "`__predicate_private__` - སྒེར་གྱི་བྱང་གཞིའི་ཤོག་བྱང་ཁོ་ན།",
  "globalSearch-instructions-operator-has": "`__operator_has__:<field>` - *<field>* ནི་ `__predicate_attachment__`, `__predicate_checklist__`, `__predicate_description__`, `__predicate_start__`, `__predicate_due__`, `__predicate_end__`, `__predicate_assignee__` ཡང་ན་ `__predicate_member__` གཅིག་ཡིན། *<field>* གོང་དུ་ `-` བཞག་ན་སྡེ་ཚན་དེར་རིན་ཐང་མེད་པ་འཚོལ། (དཔེར་ན་ `has:-due` གིས་དུས་བཀག་མེད་པའི་ཤོག་བྱང་འཚོལ།)",
  "globalSearch-instructions-operator-sort": "`__operator_sort__:<sort-name>` - *<sort-name>* ནི་ `__predicate_due__`, `__predicate_created__` ཡང་ན་ `__predicate_modified__` གཅིག་ཡིན། མར་འབབ་གོ་རིམ་ལ་གོ་རིམ་མིང་གི་གོང་དུ་ `-` ཞོག",
  "globalSearch-instructions-operator-limit": "`__operator_limit__:<n>` - *<n>* ནི་ཤོག་ངོས་རེར་སྟོན་པའི་ཤོག་བྱང་གྲངས་མཚོན་པའི་ཕོ་ཧྲིལ་གྲངས་ཤིག་ཡིན།",
  "globalSearch-instructions-notes-1": "བཀོལ་རྟགས་མང་པོ་གསལ་བཀོད་བྱེད་ཆོག",
  "globalSearch-instructions-notes-2": "འདྲ་བའི་བཀོལ་རྟགས་རྣམས་ *OR* ཡིས་མཉམ་སྦྱོར་བྱེད། ཆ་རྐྱེན་གང་རུང་དང་མཐུན་པའི་ཤོག་བྱང་ཕྱིར་སྟོན།\n`__operator_list__:Available __operator_list__:Blocked` གིས་ *Blocked* ཡང་ན་ *Available* མིང་ཅན་གྱི་ཐོ་གཞུང་གང་རུང་ནང་གི་ཤོག་བྱང་སྟོན།",
  "globalSearch-instructions-notes-3": "མི་འདྲ་བའི་བཀོལ་རྟགས་རྣམས་ *AND* ཡིས་མཉམ་སྦྱོར་བྱེད། མི་འདྲ་བའི་བཀོལ་རྟགས་ཚང་མ་དང་མཐུན་པའི་ཤོག་བྱང་ཁོ་ན་ཕྱིར་སྟོན། `__operator_list__:Available __operator_label__:red` གིས་ *Available* ཐོ་གཞུང་ནང་ *red* ཁ་བྱང་ཡོད་པའི་ཤོག་བྱང་ཁོ་ན་སྟོན།",
  "globalSearch-instructions-notes-3-2": "ཉིན་གྲངས་ཕོ་ཡང་ན་མོ་ཧྲིལ་གྲངས་ཀྱིས་ཡང་ན་ད་ལྟའི་དུས་ཡུན་ལ་ `__predicate_week__`, `__predicate_month__`, `__predicate_quarter__` ཡང་ན་ `__predicate_year__` སྤྱད་ནས་གསལ་བཀོད་བྱེད་ཆོག",
  "globalSearch-instructions-notes-4": "ཡི་གེ་འཚོལ་ཞིབ་ཀྱིས་ཡིག་ཆེ་ཆུང་ལ་ཁྱད་པར་མི་བྱེད།",
  "globalSearch-instructions-notes-5": "སྔོན་སྒྲིག་ཏུ་ཡིག་མཛོད་ཀྱི་ཤོག་བྱང་མི་འཚོལ།",
