  "password-length-filter-all": "Zwoṱhe",
  "password-length-filter-fixed": "Yo lugiswa nga phasiwede yo lapfaho zwo linganaho",
  "password-length-filter-short": "Phasiwede pfufhi vhukuma",
  "password-length-first-login": "U dzhena ha u thoma",
  "password-length-fixed": "Yo lugiswa",
  "password-length-from-environment": "Ndeme yo vhewaho kha mupo wa seva i a shuma; u vhulunga fhano zwi i dzhiela vhudzulo.",
  "password-length-last-login": "U dzhena ha u fhedza",
  "password-length-login-count": "Zwifhinga zwa u dzhena",
  "password-length-no-results": "A hu na akhaunthi fhano.",
  "password-length-report-desc": "Akhaunthi dzo dzhenaho nga phasiwede pfufhi u fhira vhulapfu ha fhasi. Ndi burausa fhedzi i ḓivhaho uri phasiwede yo lapfa hani, ngauralo i vhiga phasiwede pfufhi musi ho dzhenwa; phasiwede na vhulapfu hayo a zwi bvi kha yone. Yo lugiswa ndi musi phasiwede ya akhaunthi yo shandulwa - akhaunthi i dzhenaho hafhu nga phasiwede pfufhi i sumbedzwa hafhu i pfufhi vhukuma.",
  "password-length-saved": "Zwo vhulungwa.",
  "password-min-length": "Vhulapfu ha fhasi ha phasiwede",
  "password-min-length-description": "U dzhena nga phasiwede pfufhi hu ṅwalwa afho fhasi. U dzhena a hu hanwi nga ṅwambo uyu.",
  "password-min-length-enforce": "Kombetshedza vhulapfu ha fhasi",
  "password-min-length-enforce-description": "Phasiwede ntswa pfufhi i a hanwa, nahone akhaunthi i dzhenaho nga phasiwede pfufhi i fanela u i shandula hu sa athu itwa tshiṅwe. U i shandula zwi bvisa sesheni dzoṱhe dza akhaunthi. Phasiwede dza LDAP, OAuth2, OIDC, SAML, CAS na Sandstorm ndi dza vhaṋetshedzi vhadzo, nahone a dzi ṱolwi.",
  "password-change-required-text": "Iyi saithi zwino i ṱoḓa phasiwede dza zwiṅwalwa __min__ kana u fhira, nahone yaṋu yo pfufhi. Nangani yo lapfaho uri ni bvele phanḓa. Nga murahu sesheni dzoṱhe dza akhaunthi yaṋu dzi a bviswa, nahone ni dzhena hafhu nga phasiwede ntswa."
