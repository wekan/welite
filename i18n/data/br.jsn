  "r-when-the-assignee": "Personne assignée",
  "r-wrike-workflow": "Red-labour Wrike",
  "r-wrike-workflow-note": "Ur red-labour Wrike zo ur roll statudoù, pep hini er strollad Active, Completed, Deferred pe Cancelled. An ezporzhiañ a skriv rolloù an daolenn-mañ evel unan, anvet diouzh an daolenn, er JSON a ro API Wrike evit ar redoù-labour: krouit ar red-labour-se e Wrike a-raok enporzhiañ ezporzhiadur Excel Wrike an daolenn, evit ma vo lakaet e statudoù da dalvezout. An enporzhiañ a lenn ar JSON-se peget a-us, eus WeKan pe eus GET /workflows Wrike, en daolenn dibabet: ur statud hep roll a zeu da vezañ ur roll, hag ur reolenn a verk ur gartenn evel echu pa vez dilec'hiet d'ur statud Completed pe Cancelled ha n'eo ket echu en ur statud Active pe Deferred. Reolennoù emgefreek Wrike e-unan ne c'hallont ket bezañ ezporzhiet eus Wrike.",
  "text-contains-trigger-description": "A glot pa vez krouet ur gartenn, pe pa vez cheñchet he zitl pe he deskrivadur, ha ma vez an destenn nevez ennañ an dra-mañ (heb diforc'h etre lizherennoù bras ha bihan).",
  "text-contains-trigger-label": "Testenn da glask",
  "event-action": "Ober",
  "event-attempts": "Esaeoù",
  "event-bleed": "Anv",
  "event-category": "Rummad",
  "event-datetime": "Deiziad hag eur",
  "event-detail": "Munud",
  "event-severity": "Garvder",
  "event-source": "Mammenn",
  "password-length-report-title": "Hirder ar ger-tremen",
  "recoveryReportTitle": "Adtapout",
  "securityReportTitle": "Diogelroez",
  "event-ipv4": "Chomlec'h IPv4",
  "event-ipv6": "Chomlec'h IPv6",
  "password-change-required-title": "Kemmañ ho ker-tremen",
  "password-length-filter-all": "Pep tra",
  "password-length-filter-fixed": "Reizhet gant ur ger-tremen hir a-walc'h",
  "password-length-filter-short": "Ger-tremen re verr",
  "password-length-first-login": "Kevreadenn gentañ",
  "password-length-fixed": "Reizhet",
  "password-length-from-environment": "Ur werzh termenet e endro ar servijer a zo e talvoud; enrollañ amañ a erlec'h anezhi.",
  "password-length-last-login": "Kevreadenn ziwezhañ",
  "password-length-login-count": "Niver a gevreadennoù",
  "password-length-no-results": "Kont ebet amañ.",
  "password-length-report-desc": "Kontoù o deus kevreet gant ur ger-tremen berroc'h eget an hirder bihanañ. N'eus nemet ar merdeer a oar pegen hir eo ur ger-tremen, setu e kemenn ur ger-tremen berr goude bezañ kevreet; ar ger-tremen hag e hirder ne guitaont biskoazh anezhañ. Reizhet eo pa'z eo bet kemmet ger-tremen ar gont - ur gont a gevre en-dro gant ur ger-tremen berr a vez diskouezet en-dro evel re verr.",
  "password-length-saved": "Enrollet.",
  "password-min-length": "Hirder bihanañ ar ger-tremen",
  "password-min-length-description": "Kevreañ gant ur ger-tremen berroc'h a vez listennet amañ dindan. Ne vez morse nac'het ar gevreadenn evit se.",
  "password-min-length-enforce": "Rediañ an hirder bihanañ",
  "password-min-length-enforce-description": "Nac'het e vez ur ger-tremen nevez berroc'h, ha ret eo d'ur gont a gevre gant ur ger-tremen berroc'h e gemmañ a-raok pep tra all. E gemmañ a zigevre holl zalc'hoù ar gont. Gerioù-tremen LDAP, OAuth2, OIDC, SAML, CAS ha Sandstorm a zo d'o fourchaser, ha ne vezont ket gwiriet.",
  "password-change-required-text": "Al lec'hienn-mañ a c'houlenn bremañ gerioù-tremen gant __min__ arouezenn da nebeutañ, ha berroc'h eo hini ho kont. Dibabit unan hiroc'h evit kenderc'hel. Neuze e vo digevreet holl zalc'hoù ho kont, hag e kevreoc'h en-dro gant ar ger-tremen nevez.",
  "date-format-for-everyone": "Stumm an deiziad evit an holl",
  "calendar-system": "deiziadur",
  "show-unread-changes": "Merkañ ar c'hartennoù kemmet abaoe ma 'm eus o digoret ar wech diwezhañ",
  "show-unread-changes-desc": "Ur gartenn a zo bet kemmet he zitl, he deskrivadur, he deiziadoù, he skritelligoù, he izili, he rolloù-gwiriañ, he restroù stag pe he evezhiadennoù goude m'ho peus he digoret ar wech diwezhañ a gav ur riblenn c'hlas war he mini-gartenn, betek ma vo digoret ganeoc'h.",
  "keep-title-tags": "Mirout #tikedenn hag @ezel e titloù ar c'hartennoù nevez",
  "keep-title-tags-description": "Pa zibabit un dikedenn gant # pe un ezel gant @ en ur skrivañ titl ur gartenn nevez, e vez miret an destenn-se en titl ivez. Lazhet: an destenn a vez erlec'hiet gant an dikedenn pe an ezel.",
  "show-focus-outline": "Diskouez trolinenn ar fokus",
  "keep-add-card-form-open": "Derc'hel digor ar furmskrid Ouzhpennañ ur gartenn goude bezañ ouzhpennet ur gartenn",
  "keep-add-card-form-open-description": "Enaouet: goude ouzhpennañ ur gartenn e chom digor ar furmskrid gant un titl goullo evit ar gartenn war-lerc'h. Lazhet: serret e vez ar furmskrid kerkent ha ma vez ouzhpennet ar gartenn.",
  "title-bracket-label": "Treiñ [tikedenn] e penn-kentañ titl ur gartenn nevez en un dikedenn",
  "title-bracket-label-description": "Pa grog titl ur gartenn nevez gant [Testenn] heuliet gant muioc'h a destenn, e teu Testenn da vezañ un dikedenn eus ar gartenn (krouet ma n'eus hini ebet gant an anv-se en daolenn) hag e vez lamet eus an titl. Lazhet: miret e vez an titl evel m'emañ.",
  "submit-on-enter": "Kas an editerien gant Enter",
  "submit-on-enter-description": "Pa vez gweredekaet, Enter a enrolla titl ar gartenn, an deskrivadur hag an editerien enlinenn all; Shift+Enter a ouzhpenn ul linenn nevez. Pa vez diweredekaet, Ctrl/Cmd+Enter a enrolla hag Enter a ouzhpenn ul linenn nevez.",
  "open-many-cards-at-once": "Digeriñ meur a gartenn war un dro",
  "open-many-cards-at-once-description": "Pep kartenn a glikit warni a chom digor en he frenestr dezhi. Pa vez lazhet an dibarzh-mañ, klikañ war ur gartenn a serr an hini a oa digor.",
  "checklist-ding-sound": "Seniñ ur son pa vez echuet un elfenn eus roll gwiriañ",
  "checklist-ding-sound-description": "Seniñ ur son berr pa vez merket un elfenn eus roll gwiriañ. Diweredekaet dre ziouer.",
