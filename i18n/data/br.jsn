  "r-when-a-due-date-changed": "Pa vez lakaet pe kemmet an deiziad termen",
  "r-when-a-end-date-changed": "Pa vez lakaet pe kemmet an deiziad echuiñ",
  "r-when-a-received-date-changed": "Pa vez lakaet pe kemmet an deiziad degemer",
