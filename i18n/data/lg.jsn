  "previous-page": "Previous Muko",
  "heading-notes": "Ebiwandiiko",
  "globalSearch-instructions-heading": "Noonya Instructions",
  "globalSearch-instructions-description": "Searches sobola include operators eri refine noonya. Operators biri specified nga writing operator linnya ne muwendo separated nga colon. Ku lwa example, operator specification lya `lukalala:Blocked` would limit noonya eri kaadi ekyo biri contained mu lukalala named *Blocked*. Singa muwendo contains spaces oba special characters kyo kiteekwa ba enclosed mu quotation marks (e.g. `__operator_list__:\"Eri Review\"`).",
  "globalSearch-instructions-operators": "Kiriwo operators:",
  "globalSearch-instructions-operator-board": "`__operator_board__:<title>` - kaadi mu mbaawo matching specified *<title>*",
  "globalSearch-instructions-operator-list": "`__operator_list__:<title>` - kaadi mu nkalala matching specified *<title>*",
  "globalSearch-instructions-operator-swimlane": "`__operator_swimlane__:<title>` - kaadi mu obukubo matching specified *<title>*",
  "globalSearch-instructions-operator-comment": "`__operator_comment__:<text>` - kaadi na ky'okwogera containing *<text>*.",
  "globalSearch-instructions-operator-label": "`__operator_label__:<color>` `__operator_label__:<name>` - kaadi ekyo have kabonero matching *<color>* oba *<name>",
  "globalSearch-instructions-operator-hash": "`__operator_label_abbrev__<name|color>` - shorthand ku lwa `__operator_label__:<color>` oba `__operator_label__:<name>`",
  "globalSearch-instructions-operator-user": "`__operator_user__:<username>` - kaadi wa *<username>* kiri *memba* oba *assignee*",
  "globalSearch-instructions-operator-at": "`__operator_user_abbrev__username` - shorthand ku lwa `mukozesa:<username>`",
  "globalSearch-instructions-operator-member": "`__operator_member__:<username>` - kaadi wa *<username>* kiri *memba*",
  "globalSearch-instructions-operator-assignee": "`__operator_assignee__:<username>` - kaadi wa *<username>* kiri *assignee*",
  "globalSearch-instructions-operator-creator": "`__operator_creator__:<username>` - kaadi wa *<username>* kiri card's omutonzi",
  "globalSearch-instructions-operator-org": "`__operator_org__:<display name|short name>` - kaadi belonging eri lubaawo assigned eri ekitongole *<name>*",
  "globalSearch-instructions-operator-team": "`__operator_team__:<display name|short name>` - kaadi belonging eri lubaawo assigned eri tiimu *<name>*",
  "globalSearch-instructions-operator-due": "`__operator_due__:<n>` - kaadi ki biri due up eri *<n>* nnaku okuva now. `__operator_due__:__predicate_overdue__ nkalala byonna kaadi past byabwe ennaku ey'ekkomo.",
  "globalSearch-instructions-operator-created": "`__operator_created__:<n>` - kaadi ki byali yatonda *<n>* nnaku ago oba bitono",
  "globalSearch-instructions-operator-modified": "`__operator_modified__:<n>` - kaadi ki byali modified *<n>* nnaku ago oba bitono",
  "globalSearch-instructions-operator-status": "`__operator_status__:<status>` - wa *<status>* kiri one lya following:",
  "globalSearch-instructions-status-archived": "`__predicate_archived__` - kyaterekebwa kaadi",
  "globalSearch-instructions-status-all": "`__predicate_all__` - byonna kyaterekebwa ne unarchived kaadi",
  "globalSearch-instructions-status-ended": "`__predicate_ended__` - kaadi na ennaku y'okumaliriza",
  "globalSearch-instructions-status-public": "`__predicate_public__` - kaadi kyokka mu lwatu mbaawo",
  "globalSearch-instructions-status-private": "`__predicate_private__` - kaadi kyokka mu kyama mbaawo",
  "globalSearch-instructions-operator-has": "`__operator_has__:<field>` - wa *<field>* kiri one lya `__predicate_attachment__`, `__predicate_checklist__`, `__predicate_description__`, `__predicate_start__`, `__predicate_due__`, `__predicate_end__`, `__predicate_assignee__` oba `__predicate_member__`. Placing `-` mu front lya *<field>* searches ku lwa absence lya muwendo mu ekyo nnimiro (e.g. `has:-due` searches ku lwa kaadi awatali ennaku ey'ekkomo).",
  "globalSearch-instructions-operator-sort": "`__operator_sort__:<sort-name>` - wa *<sort-name>* kiri one lya `__predicate_due__`, `__predicate_created__` oba `__predicate_modified__`. Ku lwa descending tegeka, place `-` mu front lya tegeka linnya.",
  "globalSearch-instructions-operator-limit": "`__operator_limit__:<n>` - wa *<n>* kiri positive integer expressing namba lya kaadi eri ba displayed per muko.",
  "globalSearch-instructions-notes-1": "Multiple operators kiyinza ba specified.",
  "globalSearch-instructions-notes-2": "Similar operators biri *Oba*ed together. Kaadi ekyo match kyonna lya conditions kijja ba returned.\n`__operator_list__:Kiriwo __operator_list__:Blocked` would return kaadi contained mu kyonna lukalala named *Blocked* oba *Kiriwo*.",
  "globalSearch-instructions-notes-3": "Differing operators biri *Ne*ed together. Kyokka kaadi ekyo match byonna lya differing operators biri returned. `__operator_list__:Kiriwo __operator_label__:red` returns kyokka kaadi mu lukalala *Kiriwo* na *red* kabonero.",
  "globalSearch-instructions-notes-3-2": "Nnaku sobola ba specified nga positive oba negative integer oba ng'okozesa `__predicate_week__`, `__predicate_month__`, `__predicate_quarter__` oba `__predicate_year__` ku lwa ekiriwo period.",
  "globalSearch-instructions-notes-4": "Bigambo searches biri case insensitive.",
  "globalSearch-instructions-notes-5": "Nga ekya bulijjo kyaterekebwa kaadi biri si searched.",
