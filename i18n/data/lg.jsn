  "password-length-last-login": "Okuyingira okusembayo",
  "password-length-login-count": "Emirundi gy'okuyingira",
  "password-length-no-results": "Tewali akawunti wano.",
  "password-length-report-desc": "Akawunti ezayingira n'ekigambo ekyekusifu ekimpi okusinga obuwanvu obusinga obutono. Browser yokka y'emanyi obuwanvu bw'ekigambo ekyekusifu, kale etegeeza ekimpi oluvannyuma lw'okuyingira; ekigambo ekyekusifu n'obuwanvu bwakyo tebigivaamu. Kitereezeddwa kitegeeza nti ekigambo ekyekusifu kya akawunti kyakyusibwa - akawunti eddamu okuyingira n'ekigambo ekimpi eddamu okulagibwa nga kimpi nnyo.",
  "password-length-saved": "Kiterekeddwa.",
  "password-min-length": "Obuwanvu obusinga obutono obw'ekigambo ekyekusifu",
  "password-min-length-description": "Okuyingira n'ekigambo ekyekusifu ekimpi kulagibwa wansi. Okuyingira tekugaanibwa olw'ekyo.",
  "password-min-length-enforce": "Kakasa obuwanvu obusinga obutono",
  "password-min-length-enforce-description": "Ekigambo ekyekusifu ekipya ekimpi kigaanibwa, era akawunti eyingira n'ekigambo ekimpi erina okukikyusa nga tennakola kirala kyonna. Okukikyusa kufulumya buli kutuula kwa akawunti. Ebigambo ebyekusifu ebya LDAP, OAuth2, OIDC, SAML, CAS ne Sandstorm bya bagaba baabyo, era tebikeberebwa.",
  "password-change-required-text": "Omukutu guno kati gwetaaga ebigambo ebyekusifu eby'ennukuta ezitakka wansi wa __min__, ate ekikyo kimpi. Londa ekiwanvu okusobola okugenda mu maaso. Oluvannyuma buli kutuula kwa akawunti yo kufulumizibwa, n'oddamu okuyingira n'ekigambo ekyekusifu ekipya.",
  "date-format-for-everyone": "Enkola y'ennaku eri buli muntu",
  "calendar-system": "Enkola ya kalenda (okulaga ennaku)",
  "show-unread-changes": "Ssaako akabonero ku kaadi ezikyuse okuva lwe nazigguddeko omulundi ogusembayo",
  "show-unread-changes-desc": "Ekaadi ng'omutwe gwayo, ennyinyonnyola, ennaku, obubonero, abamemba, olukalala lw'okukebera, ebigattiddwako oba endowooza zaayo bikyuse oluvannyuma lw'okugiggulawo omulundi ogusembayo efuna olubalama olwa bbululu ku kaadi yaayo entono, okutuusa lw'onoogiggulawo.",
  "keep-title-tags": "Kuuma #akabonero ne @memba mu mitwe gy'ekaadi empya",
  "keep-title-tags-description": "Bw'olonda akabonero ne # oba memba ne @ ng'owandiika omutwe gw'ekaadi empya, kuuma ebigambo ebyo ne mu mutwe. Kiggale: ebigambo bikyusibwamu akabonero oba memba.",
  "show-focus-outline": "Laga ekikulaakulanya ky’okussa omwoyo",
  "keep-add-card-form-open": "Kuuma foomu ya Yongerako ekaadi nga nzigule oluvannyuma lw'okwongerako ekaadi",
  "keep-add-card-form-open-description": "Kiggule: ekaadi bw'emala okwongerebwako, foomu esigala nga nzigule n'omutwe omwereere ku kaadi eddako. Kiggale: foomu eggalwawo ekaadi bw'emala okwongerebwako.",
  "title-bracket-label": "Fuula [akabonero] ku ntandikwa y'omutwe gw'ekaadi empya okubeera akabonero",
  "title-bracket-label-description": "Omutwe gw'ekaadi empya bwe gutandika ne [Ebigambo] era ne wabaawo ebigambo ebirala oluvannyuma, Ebigambo bifuuka akabonero k'ekaadi (kakolebwa singa olubaawo terulina kabonero ka linnya eryo) era biggibwa mu mutwe. Kiggale: omutwe gusigala nga bwe guli.",
  "submit-on-enter": "Submit editors na Yingiza",
  "submit-on-enter-description": "Nga ku, pressing Yingiza saves kaadi mutwe, kunnyonnyola ne kirala inline editors; Shift+Yingiza inserts kipya line. Nga off, Ctrl/Cmd+Yingiza saves ne Yingiza inserts kipya line.",
  "open-many-cards-at-once": "Ggulawo many kaadi ku once",
  "open-many-cards-at-once-description": "Keep every kaadi ggwe click ggulawo mu kyakyo own window. Nga kino kiri off, clicking kaadi closes one ekyo kyali ggulawo.",
