  "import-trello-json-file": "Datoteca .json da Trello",
  "import-trello-json-file-hint": "Ina tabella Trello exportada sco .json. Sche ti has memorisà la clav API ed il token da Trello, vegnan era telechargiads sias agiuntas, il fund da la tabella ed ils avatars dals commembers.",
  "import-trello-zip-file": "Datoteca .zip da Trello",
