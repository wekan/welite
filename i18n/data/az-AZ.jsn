  "globalSearch-instructions-operator-hash": "`__operator_label_abbrev__<name|color>` - ​​`__operator_label__:<color>` və ya `__operator_label__:<name>` üçün stenoqrafiya",
  "globalSearch-instructions-operator-user": "`__operator_user__:<username>` - ​​*<username>*-nin *üzv* və ya *təyin edilmiş* olduğu kartlar",
  "globalSearch-instructions-operator-at": "`__operator_user_abbrev__username` - ​​`user:<username>` üçün stenoqrafiya",
  "globalSearch-instructions-operator-member": "`__operator_member__:<username>` - ​​*<username>*-nin *üzv* olduğu kartlar",
  "globalSearch-instructions-operator-assignee": "`__operator_assignee__:<username>` - *<username>* adlı istifadəçinin *təyin edilmiş şəxs* olduğu kartlar",
