  "globalSearch-instructions-heading": "Maskana yachachiykuna",
  "globalSearch-instructions-description": "Maskaykunaqa operadorkunata apanmanmi maskayta allichanapaq. Operadorkunaqa operadorpa sutinta chanintawan iskay chiqitawan (:) t'aqaspa qillqasqa kanku. Kay hina, `list:Blocked` operadorqa maskayta *Blocked* sutiyuq sutisuyupi kaq kartakunallaman saywanman. Chanipi ch'usaq kitikuna utaq sapan siq'ikuna kaptinqa, rimay unanchakunapi wichqasqa kanan (kay hina `__operator_list__:\"To Review\"`).",
  "globalSearch-instructions-operators": "Kaq operadorkuna:",
  "globalSearch-instructions-operator-board": "`__operator_board__:<title>` - *<title>*wan tupaq pirqakunapi kartakuna",
  "globalSearch-instructions-operator-list": "`__operator_list__:<title>` - *<title>*wan tupaq sutisuyukunapi kartakuna",
  "globalSearch-instructions-operator-swimlane": "`__operator_swimlane__:<title>` - *<title>*wan tupaq ñankunapi kartakuna",
  "globalSearch-instructions-operator-comment": "`__operator_comment__:<text>` - *<text>* apaq rimayniyuq kartakuna.",
  "globalSearch-instructions-operator-label": "`__operator_label__:<color>` `__operator_label__:<name>` - *<color>* utaq *<name>*wan tupaq unanchayuq kartakuna",
  "globalSearch-instructions-operator-hash": "`__operator_label_abbrev__<name|color>` - `__operator_label__:<color>` utaq `__operator_label__:<name>`-pa pisiyachisqan",
  "globalSearch-instructions-operator-user": "`__operator_user__:<username>` - *<username>* *ayllumasi* utaq *ruraq* kaq kartakuna",
  "globalSearch-instructions-operator-at": "`__operator_user_abbrev__username` - `user:<username>`-pa pisiyachisqan",
  "globalSearch-instructions-operator-member": "`__operator_member__:<username>` - *<username>* *ayllumasi* kaq kartakuna",
  "globalSearch-instructions-operator-assignee": "`__operator_assignee__:<username>` - *<username>* *ruraq* kaq kartakuna",
  "globalSearch-instructions-operator-creator": "`__operator_creator__:<username>` - *<username>* kartap kamaqnin kaq kartakuna",
  "globalSearch-instructions-operator-org": "`__operator_org__:<display name|short name>` - *<name>* huñunakuyman churasqa pirqap kartankuna",
  "globalSearch-instructions-operator-team": "`__operator_team__:<display name|short name>` - *<name>* huñuman churasqa pirqap kartankuna",
  "globalSearch-instructions-operator-due": "`__operator_due__:<n>` - kunanmanta *<n>* p'unchawkunakama tukuy pachayuq kartakuna. `__operator_due__:__predicate_overdue__ tukuy pachanmanta qhipa kaq llapan kartakunata rikuchin.",
  "globalSearch-instructions-operator-created": "`__operator_created__:<n>` - *<n>* p'unchawkuna ñawpaqta utaq aswan qayllapi kamasqa kartakuna",
  "globalSearch-instructions-operator-modified": "`__operator_modified__:<n>` - *<n>* p'unchawkuna ñawpaqta utaq aswan qayllapi tikrasqa kartakuna",
  "globalSearch-instructions-operator-status": "`__operator_status__:<status>` - *<status>*qa kaykunamanta hukninmi:",
  "globalSearch-instructions-status-archived": "`__predicate_archived__` - waqaychasqa kartakuna",
  "globalSearch-instructions-status-all": "`__predicate_all__` - llapan waqaychasqa mana waqaychasqa kartakunapas",
  "globalSearch-instructions-status-ended": "`__predicate_ended__` - tukukuy p'unchawniyuq kartakuna",
  "globalSearch-instructions-status-public": "`__predicate_public__` - llapanpaq pirqakunapi kaq kartakunalla",
  "globalSearch-instructions-status-private": "`__predicate_private__` - sapallan pirqakunapi kaq kartakunalla",
  "globalSearch-instructions-operator-has": "`__operator_has__:<field>` - *<field>*qa kaykunamanta hukninmi: `__predicate_attachment__`, `__predicate_checklist__`, `__predicate_description__`, `__predicate_start__`, `__predicate_due__`, `__predicate_end__`, `__predicate_assignee__` utaq `__predicate_member__`. *<field>*pa ñawpaqninpi `-` churayqa chay kanchapi chani mana kasqanta maskan (kay hina `has:-due` mana tukuy pachayuq kartakunata maskan).",
  "globalSearch-instructions-operator-sort": "`__operator_sort__:<sort-name>` - *<sort-name>*qa kaykunamanta hukninmi: `__predicate_due__`, `__predicate_created__` utaq `__predicate_modified__`. Uraman ñiqichanapaqqa, ñiqichay sutip ñawpaqninpi `-` churay.",
  "globalSearch-instructions-operator-limit": "`__operator_limit__:<n>` - *<n>*qa sapa p'anqapi rikuchina kartakunap yupayninta niq aswan ch'usaqmanta hatun hunt'a yupaymi.",
  "globalSearch-instructions-notes-1": "Achka operadorkunata churayta atikun.",
  "globalSearch-instructions-notes-2": "Kaqlla operadorkunaqa *UTAQ*wan huñusqa kanku. Mayqin kamachiywanpas tupaq kartakunam kutimun.\n`__operator_list__:Available __operator_list__:Blocked` *Blocked* utaq *Available* sutiyuq mayqin sutisuyupipas kaq kartakunata kutichimunman.",
  "globalSearch-instructions-notes-3": "Hukniray operadorkunaqa *HINALLATAQ*wan huñusqa kanku. Llapan hukniray operadorkunawan tupaq kartakunallam kutimun. `__operator_list__:Available __operator_label__:red` *Available* sutisuyupi *puka* unanchayuq kartakunallata kutichimun.",
  "globalSearch-instructions-notes-3-2": "P'unchawkunaqa aswan ch'usaqmanta hatun utaq aswan ch'usaqmanta uchuy hunt'a yupaywan churasqa kanman, utaq kunan pachapaq `__predicate_week__`, `__predicate_month__`, `__predicate_quarter__` utaq `__predicate_year__` nisqawan.",
  "globalSearch-instructions-notes-4": "Qillqa maskaykunaqa hatun uchuy qillqakunata manam t'aqanchu.",
  "globalSearch-instructions-notes-5": "Ñawpaqmantaqa waqaychasqa kartakunaqa manam maskasqachu.",
