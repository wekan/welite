  "operator-number-expected": "运算符 __operator__ 需要一只数字，收到个是“__value__”",
  "operator-sort-invalid": "“%s”个排序无效",
  "operator-status-invalid": "“%s”勿是有效个状态",
  "operator-has-invalid": "%s 勿是有效个存在检查",
