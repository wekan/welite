  "event-ipv4": "Ñiiɓirde IPv4",
  "event-ipv6": "Ñiiɓirde IPv6",
  "password-change-required-title": "Waylu finnde suuraande maa",
  "password-length-filter-all": "Fof",
  "password-length-filter-fixed": "Feewnaama e finnde njuutunde no haanirta",
  "password-length-filter-short": "Finnde suuraande ɓuuftunde no feewi",
  "password-length-first-login": "Naatgol arandeewol",
  "password-length-fixed": "Feewnaama",
  "password-length-from-environment": "Keewal teeltaangal e taariindi sarworde ndee ina gollira; danndude ɗoo ina lomtoo ɗum.",
  "password-length-last-login": "Naatgol sakkitiingol",
  "password-length-login-count": "Limoore naatgol",
  "password-length-no-results": "Alaa konte ɗoo.",
  "password-length-report-desc": "Konte naatnooɗe e finnde suuraande ɓuuftunde njuuteendi famɗundi. Ko wanngorde tan anndi no finnde suuraande njuutiri, ɗum noon nde habrata ɓuuftunde caggal naatgol; finnde ndee e njuuteendi mayre ndaraaki hay so wakkati. Feewnaama ko nde finnde suuraande konte ndee waylaa - konte naatoore kadi e finnde ɓuuftunde hollirtee kadi wano ɓuuftunde no feewi.",
  "password-length-saved": "Danndaama.",
  "password-min-length": "Njuuteendi famɗundi finnde suuraande",
  "password-min-length-description": "Naatgol e finnde ɓuuftunde ina limtaa les. Naatgol haɗataake abada sabu ɗum.",
  "password-min-length-enforce": "Waɗtin njuuteendi famɗundi",
  "password-min-length-enforce-description": "Finnde hesere ɓuuftunde ina haɗaa, konte naatoore e finnde ɓuuftunde ina foti waylude nde ado huunde woɗnde. Waylude nde ina yaltina kala naatgol konte ndee. Finndeeji suuraaɗi LDAP, OAuth2, OIDC, SAML, CAS e Sandstorm ko ɗi jeyaaɓe hokkooɓe mum, ɗi ƴeewtataake.",
  "password-change-required-text": "Lowre ndee jooni ina naamnii finndeeji suuraaɗi alkule __min__ ko famɗi fof, maa ndee ko ɓuuftunde. Suɓo njuutunde ngam jokkude. Caggal ɗum kala naatgol konte maa yaltinte, a naatoto kadi e finnde suuraande hesere ndee.",
  "date-format-for-everyone": "Mbaydi ñalngu wonande kala neɗɗo",
  "calendar-system": "Njuɓɓudi haatumeere (hollirde ñalnde)",
  "show-unread-changes": "Maanto kartal ɗe waylaa gila mi udditi ɗe sakket",
  "show-unread-changes-desc": "Kartal ngal innde mum, sifaa mum, ñalɗi mum, maandeeji mum, terɗe mum, doggol ƴeewtoore, ceŋaaɗi walla miijooji mum waylii caggal nde uddit-ɗaa ngal sakket heɓat kaŋŋe bulaajo e kartal mum tokooso, haa nde uddit-ɗaa ngal.",
  "keep-title-tags": "Mooftu #maandeeji e @terɗe nder tiitoonde kartal kesal",
  "keep-title-tags-description": "So a suɓii maandeeji e # walla terɗo e @ tuma nde mbinndataa tiitoonde kartal kesal, mooftu ndeen binndi nder tiitoonde ndee kadi. Ñifaama: binndi ndii lomtetee maandeeji walla terɗo oo.",
  "show-focus-outline": "Sutaade bolle fokus",
  "keep-add-card-form-open": "Haɗ fomme ɓeydugol kartal udditiinde caggal ɓeydude kartal",
  "keep-add-card-form-open-description": "Huɓɓinaa: caggal nde kartal ɓeydaa, fomme ndee heddotoo udditiinde e tiitoonde mehe ngam kartal garoowal. Ñifaa: fomme ndee uddotoo so kartal ngal ɓeydaama.",
  "title-bracket-label": "Waylu [maandeeji] ka fuɗɗoode tiitoonde kartal kesal maandeeji",
  "title-bracket-label-description": "Nde tiitoonde kartal kesal fuɗɗorii [Binndi] rewaa e binndi goɗɗi, Binndi ngonta maandeeji kartal ngal (ɗi tagetee so alluwal ngal alaa maandeeji innde ndee) ɗi itte e tiitoonde ndee. Ñifaama: tiitoonde ndee heddoto no wonirnoo.",
  "submit-on-enter": "Neldu taƴtorɗe e Enter",
  "submit-on-enter-description": "So hurminaama, dobagol Enter mooftata hoore kartal, cifagol e taƴtorɗe goɗɗe e gorol; Shift+Enter naatnata gorol kesol. So dartinaama, Ctrl/Cmd+Enter mooftata tee Enter naatnata gorol kesol.",
  "open-many-cards-at-once": "Uddit karte keewɗe e laawol gootol",
  "open-many-cards-at-once-description": "Accu kartal kala ɗe ndob-ɗaa udditii e henorde mum. So ɗum dartinaama, dobagol kartal uddat ngal udditinoongal.",
  "checklist-ding-sound": "Fewnu daaɗe tuma checklist fii heɓi timmude",
  "checklist-ding-sound-description": "Fewnu daaɗe famɗuɗe tuma toɓɓaa fii checklist. Ko daaɗeeji ɗe udditaaki.",
