  "globalSearch-instructions-operator-list": "`__operator_list__:<ⴰⵣⵡⵍ>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴳ ⵜⵍⴳⴰⵎⵉⵏ ⵉⵎⵙⴰⵙⴰⵏ ⴷ *<ⴰⵣⵡⵍ>* ⵉⵥⵍⵉⵏ",
  "globalSearch-instructions-operator-swimlane": "`__operator_swimlane__:<title>` - ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⴳ ⵉⴱⵔⵉⴷⵏ ⵉⵎⵙⴰⵙⴰⵏ ⴷ ⵓⵣⵡⵍ ⵉⵜⵜⵓⴼⴽⴰⵏ *<title>*",
  "globalSearch-instructions-operator-comment": "`__operator_comment__:<ⴰⴹⵕⵉⵙ>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵙ ⵓⵖⴼⴰⵡⴰⵍ ⵢⵓⵎⴰⵏ *<ⴰⴹⵕⵉⵙ>*.",
  "globalSearch-instructions-operator-label": "`__operator_label__:<ⴰⴽⵍⵓ>` `__operator_label__:<ⵉⵙⵎ>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵙ ⵓⵔⵛⵓⵎ ⵉⵎⵙⴰⵙⴰⵏ ⴷ *<ⴰⴽⵍⵓ>* ⵏⵖ *<ⵉⵙⵎ>*.",
  "globalSearch-instructions-operator-hash": "`__operator_label_abbrev__<ⵉⵙⵎ|ⴰⴽⵍⵓ>` - ⴰⵙⴳⵣⵍ ⵏ `__operator_label__:<ⴰⴽⵍⵓ>` ⵏⵖ `__operator_label__:<ⵉⵙⵎ>`",
  "globalSearch-instructions-operator-user": "`__operator_user__:<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>` - ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⵏⵏⴰ ⴳ ⵉⴳⴰ *<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>* *ⴰⴳⵎⴰⵎ* ⵏⵖ *ⴰⴼⴳⴰⵏ ⵉ ⵎⵉ ⵜⵜⵓⴼⴽⴰ ⵜⴰⴽⴰⵕⴹⴰ*",
  "globalSearch-instructions-operator-at": "`__operator_user_abbrev__username` - ⴰⵎⵥⵥⴰⵢ ⵏ `user:<username>`",
  "globalSearch-instructions-operator-member": "`__operator_member__:<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵏⵏⴰ ⴳ ⵉⴳⴰ *<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>* *ⴰⴳⵎⴰⵎ*",
  "globalSearch-instructions-operator-assignee": "`__operator_assignee__:<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>` - ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⵏⵏⴰ ⴳ ⵉⴳⴰ *<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>* *ⴰⴼⴳⴰⵏ ⵉ ⵎⵉ ⵜⵜⵓⴼⴽⴰ ⵜⴰⴽⴰⵕⴹⴰ*",
  "globalSearch-instructions-operator-creator": "`__operator_creator__:<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵏⵏⴰ ⵉⴳⴰ *<ⵉⵙⵎ ⵏ ⵓⵏⵙⵙⵎⵔⵙ>* ⴰⵎⵙⵏⴼⵍⵓⵍ ⵏⵏⵙⵏⵜ",
  "globalSearch-instructions-operator-org": "`__operator_org__:<display name|short name>` - ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⵏ ⵜⴼⵍⵡⵉⵜ ⵜⵜⵓⴼⴽⴰⵏ ⵉ ⵜⵓⴷⴷⵙⴰ *<name>*",
  "globalSearch-instructions-operator-team": "`__operator_team__:<display name|short name>` - ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⵏ ⵜⴼⵍⵡⵉⵜ ⵜⵜⵓⴼⴽⴰⵏ ⵉ ⵜⴰⵔⴰⴱⴱⵓⵜ *<name>*",
  "globalSearch-instructions-operator-due": "`__operator_due__:<n>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵙ ⵓⵙⴰⴽⵓⴷ ⴰⵎⴳⴳⴰⵔⵓ ⴰⵔ *<n>* ⵏ ⵡⵓⵙⵙⴰⵏ ⵙⴳ ⴷⵖⵉ.\n`__operator_due__:__predicate_overdue__` ⵉⵙⵙⴽⵏ ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴰⴽⴽⵯ ⵙ ⵓⵙⴰⴽⵓⴷ ⴰⵎⴳⴳⴰⵔⵓ ⴷⴰⵜ ⵏ ⴷⵖⵉ.",
  "globalSearch-instructions-operator-created": "`__operator_created__:<n>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵍⵍⵉ ⵜⵜⵓⵙⵏⵓⵍⴼⴰⵏⵜ ⴳ *<n>* ⵏ ⵡⵓⵙⵙⴰⵏ ⵉⵎⴳⴳⵓⵔⴰ",
  "globalSearch-instructions-operator-modified": "`__operator_modified__:<n>` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵍⵍⵉ ⵜⵜⵓⵙⵙⵏⴼⵍⵏⵜ ⴳ *<n>* ⵏ ⵡⵓⵙⵙⴰⵏ ⵉⵎⴳⴳⵓⵔⴰ",
  "globalSearch-instructions-operator-status": "`__operator_status__:<ⴰⴷⴷⴰⴷ>` - ⵉⴳⴰ *<ⴰⴷⴷⴰⴷ>* ⵢⴰⵏ ⵙⴳ ⵉⴷⴷⴰⴷⵏ ⴰⴷ:",
  "globalSearch-instructions-status-archived": "`__predicate_archived__` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴳ ⴰⵔⵛⵉⴼ",
  "globalSearch-instructions-status-all": "`__predicate_all__` - ⴰⴽⴽⵯ ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⴳ ⴰⵔⵛⵉⴼ ⴷ ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⵓⵔ ⵍⵍⵉⵏⵜ ⴳ ⴰⵔⵛⵉⴼ",
  "globalSearch-instructions-status-ended": "`__predicate_ended__` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵏⵏⴰ ⵖⵓⵔⵙⵏⵜ ⵉⵍⵍⴰ ⴰⵙⴰⴽⵓⴷ ⵏ ⵜⵉⴳⵉⵔⴰ",
  "globalSearch-instructions-status-public": "`__predicate_public__` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴳ ⵜⴼⵍⵡⵉⵏ ⵜⵉⴳⴷⵓⴷⴰⵏⵉⵏ ⵖⴰⵙ",
  "globalSearch-instructions-status-private": "`__predicate_private__` - ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴳ ⵜⴼⵍⵡⵉⵏ ⵜⵓⵙⵍⵉⴳⵉⵏ ⵖⴰⵙ",
  "globalSearch-instructions-operator-has": "`__operator_has__:<field>` - ⵍⵍⵉ ⴳ *<field>* ⵉⴳⴰ ⵢⴰⵏ ⵙⴳ `__predicate_attachment__`, `__predicate_checklist__`, `__predicate_description__`, `__predicate_start__`, `__predicate_due__`, `__predicate_end__`, `__predicate_assignee__` ⵏⵖ `__predicate_member__`. ⵎⴽ ⵜⵙⵔⵙⴷ `-` ⴷⴰⵜ *<field>*, ⴰⵔ ⵉⵔⵣⵣⵓ ⵖⴼ ⵜⵉⵍⵍⵉ ⵏ ⵓⵣⴰⵍ ⴳ ⵓⴳⵔ ⴰⵏⵏ (ⴰⵎⴷⵢⴰ `has:-due` ⴰⵔ ⵉⵔⵣⵣⵓ ⵖⴼ ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴱⵍⴰ ⴰⵙⴰⴽⵓⴷ ⴰⵎⴳⴳⴰⵔⵓ).",
  "globalSearch-instructions-operator-sort": "`__operator_sort__:<ⵉⵙⵎ ⵏ ⵓⴼⵔⴰⵏ>` - ⵉⴳⴰ *<ⵉⵙⵎ ⵏ ⵓⴼⵔⴰⵏ>* ⵢⴰⵏ ⵙⴳ `__predicate_due__`, `__predicate_created__` ⵏⵖ `__predicate_modified__`. ⵉ ⵓⴼⵔⴰⵏ ⵜⴰⴽⵙⴰⵔⵜ, ⵔⵏⵓ `-` ⴷⴰⵜ ⵏ ⵉⵙⵎ ⵏ ⵓⴼⵔⴰⵏ.",
  "globalSearch-instructions-operator-limit": "`__operator_limit__:<n>` - ⵎⴰⵏⵉ *<n>* ⵉⴳⴰ ⴰⵎⴹⴰⵏ ⵓⵎⵉⴹ ⴰⵔⴰⵜⴰⵏ ⵉⵎⵎⴰⵍⵏ ⵎⵏⵛⴽ ⵏ ⵜⴽⴰⵕⴹⵉⵡⵉⵏ ⴰⴷ ⵜⵜⵓⵙⴽⴰⵏⵏⵜ ⴳ ⵢⴰⵍ ⵜⴰⵙⵏⴰ.",
  "globalSearch-instructions-notes-1": "ⵜⵣⵎⵔⴷ ⴰⴷ ⵜⵙⵙⵎⵔⵙⴷ ⵉⵎⴰⵀⴰⵍⵏ ⵉⴳⴳⵓⵜⵏ.",
  "globalSearch-instructions-notes-2": "ⵉⵎⴰⵀⴰⵍⵏ ⵉⵎⵙⴰⵙⴰⵏ ⵇⵇⵏⵏ ⵙ *OR* (ⵏⵖ). ⴰⵔ ⵜⵜⵢⴰⵔⴰⵔⵏⵜ ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵉⵎⵙⴰⵙⴰⵏ ⴷ ⴽⵔⴰ ⵏ ⵜⵡⵜⵉⵍⵜ.\n`__operator_list__:Available __operator_list__:Blocked` ⴰⵔ ⵉⵜⵜⴰⵔⴰⵔ ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴳ ⴽⵔⴰ ⵏ ⵜⵍⴳⴰⵎⵜ ⵉⵙⵎ ⵏⵏⵙ *Blocked* ⵏⵖ *Available*.",
  "globalSearch-instructions-notes-3": "ⵉⵎⴰⵀⴰⵍⵏ ⵉⵎⵣⴰⵔⴰⵢⵏ ⵇⵇⵏⵏ ⵙ *AND* (ⴷ). ⴰⵔ ⵜⵜⵢⴰⵔⴰⵔⵏⵜ ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⵉⵎⵙⴰⵙⴰⵏ ⴷ ⴰⴽⴽⵯ ⵉⵎⴰⵀⴰⵍⵏ ⵉⵎⵣⴰⵔⴰⵢⵏ ⵖⴰⵙ. `__operator_list__:Available __operator_label__:red` ⴰⵔ ⵉⵜⵜⴰⵔⴰⵔ ⵜⵉⴽⴰⵕⴹⵉⵡⵉⵏ ⴳ ⵜⵍⴳⴰⵎⵜ *Available* ⵙ ⵓⵔⵛⵓⵎ *red* ⵖⴰⵙ.",
  "globalSearch-instructions-notes-3-2": "ⵉⵣⵎⵔ ⵓⵙⵙⴰⵏ ⴰⴷ ⵜⵜⵓⵙⴱⴷⴷⵏ ⵙ ⵓⵎⴹⴰⵏ ⵓⵎⵉⴹ ⴰⵔⴰⵜⴰⵏ ⵏⵖ ⴰⵎⴰⵣⵉⵔ, ⵏⵖ ⵙ `__predicate_week__`, `__predicate_month__`, `__predicate_quarter__` ⵏⵖ `__predicate_year__` ⵉ ⵓⵣⵎⵣ ⴰⵎⵉⵔⴰⵏ.",
  "globalSearch-instructions-notes-4": "ⴰⵔⵣⵣⵓ ⵏ ⵓⴹⵕⵉⵚ ⵓⵔ ⵉⵙⵏⴰⵃⵢⴰ ⴳⵔ ⵉⵙⴽⴽⵉⵍⵏ ⵉⵎⵇⵇⵔⴰⵏⵏ ⴷ ⵉⵎⵥⵥⵢⴰⵏⵏ (A/a).",
  "globalSearch-instructions-notes-5": "ⵙ ⵓⵡⵏⵓⵍ, ⵜⵉⴽⴰⵔⴹⵉⵡⵉⵏ ⴳ ⴰⵔⵛⵉⴼ ⵓⵔ ⵜⵜⵓⵔⵣⵓⵏⵜ.",
