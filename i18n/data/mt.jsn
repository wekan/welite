  "operator-unknown-error": "%s huwa mhux an operator",
  "operator-number-expected": "l-operatur __operator__ stenna numru, iżda rċieva '__value__'",
  "operator-sort-invalid": "sort ta’ '%s' huwa invalid",
  "operator-status-invalid": "'%s' huwa mhux a valid status",
  "operator-has-invalid": "%s huwa mhux a valid existence check",
  "operator-limit-invalid": "%s huwa mhux a valid limit.  Limit should be a positive integer.",
